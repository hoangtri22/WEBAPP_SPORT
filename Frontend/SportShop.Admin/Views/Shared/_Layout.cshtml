@{
    string menu = ViewBag.Menu as string ?? "";
    bool bare = ViewBag.Bare == true;

    int unanswered = ViewData["Unanswered"] as int? ?? 0;

    bool isAdminAccount = string.Equals(User.FindFirst("username")?.Value, "admin", StringComparison.OrdinalIgnoreCase);
    var self = ViewData["Self"] as Employee;
    string fullName = isAdminAccount ? "Admin" : self != null ? $"{self.LastName} {self.FirstName}".Trim() : User.Identity?.Name ?? "";
    string firstName = isAdminAccount ? "Admin" : self?.FirstName ?? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? fullName;
    string role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string empCode = "NV" + (User.FindFirst("employee_id")?.Value ?? "0").PadLeft(3, '0');
    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string initials = nameParts.Length == 0 ? "?" : (nameParts[^1][..1] + (nameParts.Length > 1 ? nameParts[0][..1] : "")).ToUpper();

    (string key, string text, string controller, string action, string icon)[] items =
    [
        ("home", "Tổng quan", "Home", "Index", "layout-dashboard"),
        ("account", "Tài khoản & Phân quyền", "Account", "Index", "shield-check"),
        ("employees", "Quản lý nhân viên", "Employees", "Index", "user"),
        ("customers", "Quản lý khách hàng", "Customers", "Index", "users"),
        ("categories", "Quản lý loại sản phẩm", "Products", "Categories", "boxes"),
        ("products", "Quản lý sản phẩm", "Products", "Index", "package"),
        ("suppliers", "Quản lý nhà cung cấp", "Suppliers", "Index", "store"),
        ("imports", "Quản lý nhập hàng", "Imports", "Index", "layers"),
        ("promotions", "Khuyến mãi & Marketing", "Promotions", "Index", "badge-percent"),
        ("orders", "Quản lý đơn đặt hàng và giao hàng", "Orders", "Index", "shopping-cart"),
        ("invoices", "Quản lý hóa đơn", "Orders", "Invoices", "file-text"),
        ("feedback", "Phản hồi khách hàng", "Feedback", "Index", "message-square"),
        ("surveys", "Khảo sát", "Feedback", "Surveys", "clipboard-list"),
        ("reports", "Báo cáo thống kê", "Reports", "Index", "bar-chart"),
        ("stats", "Thống kê doanh thu", "Stats", "Index", "trending-up"),
    ];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="~/js/tab-session.js" data-cookie="sportshop-admin-tab"></script>
    <title>@(ViewData["Title"] ?? "SportShop") - SportShop Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="@(bare ? "bare" : "")">
@if (bare)
{
    @RenderBody()
}
else
{
    <aside class="sidebar" id="sidebar">
        <div class="brand">
            <button type="button" class="icon-btn js-nav-toggle" aria-label="Thu gọn / mở menu">@Icons.Svg("menu", 22)</button>
            <span class="brand-mark" title="Mở rộng menu">@Icons.Svg("activity", 24)</span>
            <span class="brand-name">SPORT<b>SHOP</b></span>
        </div>
        <nav class="nav">
            @foreach (var it in items.Where(i => !(i.key == "employees" && role == "Nhân viên")))
            {
                <a class="nav-item @(menu == it.key ? "active" : "")" asp-controller="@it.controller" asp-action="@it.action" title="@it.text">
                    @Icons.Svg(it.icon, 22)
                    <span class="nav-text">@it.text</span>
                    @if (it.key == "feedback" && unanswered > 0)
                    {
                        <span class="nav-badge">@unanswered</span>
                    }
                </a>
            }
        </nav>
        <div class="help">
            <span class="help-ico">@Icons.Svg("headphones", 22)</span>
            <div><div class="help-title">Cần hỗ trợ?</div><div class="help-mail">support@sportshop.vn</div></div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button type="button" class="icon-btn mobile-only js-nav-toggle" aria-label="Mở menu">@Icons.Svg("menu", 22)</button>
            <div class="hello"><small>Chào mừng trở lại,</small><strong>@role @firstName</strong></div>
            <div class="topbar-right">
                <div class="user">
                    <span class="avatar">@initials</span>
                    <div class="user-info"><strong>@fullName</strong><small>@empCode</small></div>
                </div>
                <a class="btn-outline logout" asp-controller="Account" asp-action="Logout">@Icons.Svg("log-out", 18) <span>Đăng xuất</span></a>
            </div>
        </header>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    @Html.AntiForgeryToken()
    <div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
    <aside class="drawer" id="drawer" hidden aria-label="Biểu mẫu"></aside>
}
<script src="~/js/search-kit.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
