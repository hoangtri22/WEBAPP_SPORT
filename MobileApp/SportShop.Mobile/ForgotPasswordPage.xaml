<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.ForgotPasswordPage" x:DataType="vm:ForgotPasswordViewModel"
             BackgroundColor="{StaticResource Bg}" Title="Quên mật khẩu">
    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,20" Spacing="14">
            <Label Text="Quên mật khẩu" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource Ink}" />

            <VerticalStackLayout IsVisible="{Binding NeedsEmail}" Spacing="14">
                <Label Text="Nhập email của tài khoản, chúng tôi sẽ gửi mã xác nhận gồm 6 chữ số." Style="{StaticResource SmallMuted}" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_mail_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Email" Style="{StaticResource FieldEntry}" Keyboard="Email" MaxLength="100"
                               ReturnType="Go" ReturnCommand="{Binding SendCodeCommand}" AutomationId="ForgotEmail" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding CodeSent}" Spacing="14">
                <Label Text="{Binding SentText}" Style="{StaticResource SmallMuted}" AutomationId="ForgotSent" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding Code}" Placeholder="Mã xác nhận" Style="{StaticResource FieldEntry}" Keyboard="Numeric" MaxLength="6" AutomationId="ForgotCode" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding NewPassword}" Placeholder="Mật khẩu mới" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128" AutomationId="ForgotNewPassword" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding ConfirmPassword}" Placeholder="Nhập lại mật khẩu mới" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128"
                               ReturnType="Go" ReturnCommand="{Binding ResetCommand}" AutomationId="ForgotConfirmPassword" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasError}" BackgroundColor="#FDECEC" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" AutomationId="ForgotError" />
            </Border>

            <Button Text="Gửi mã xác nhận" Command="{Binding SendCodeCommand}" IsVisible="{Binding NeedsEmail}" Style="{StaticResource PrimaryButton}" AutomationId="ForgotSend" />
            <Button Text="Đặt lại mật khẩu" Command="{Binding ResetCommand}" IsVisible="{Binding CodeSent}" Style="{StaticResource PrimaryButton}" AutomationId="ForgotReset" />
            <Button Text="Gửi lại mã" Command="{Binding SendCodeCommand}" IsVisible="{Binding CodeSent}" Style="{StaticResource OutlineButton}" AutomationId="ForgotResend" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Teal}" />
            <Button Text="Quay lại đăng nhập" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="{StaticResource Teal}" AutomationId="ForgotBack" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
