<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.OrdersPage"
             x:DataType="vm:OrdersViewModel"
             BackgroundColor="#F5F7FA"
             Title="Đơn hàng của tôi">

    <RefreshView Refreshing="OnRefreshing"
                 IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="18,16,18,28" Spacing="16">

                <!-- Tiêu đề giống hệt Views/Customer/Orders.cshtml dòng 7 -->
                <VerticalStackLayout Spacing="3">
                    <Label Text="TÀI KHOẢN CỦA TÔI" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.2" TextColor="#0F766E" />
                    <Label Text="Đơn hàng của tôi" FontFamily="OpenSansSemibold" FontSize="22" TextColor="#102C46" />
                    <Label Text="Theo dõi trạng thái đơn hàng, cửa hàng cập nhật mỗi khi xử lý." FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Tìm kiếm nhanh & lọc trạng thái đơn -->
                <VerticalStackLayout Spacing="10">
                    <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                        <Entry Text="{Binding SearchKeyword}" Placeholder="Tìm theo mã đơn, sản phẩm, người nhận..." FontSize="13" ClearButtonVisibility="WhileEditing" />
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusTabs}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrderStatusTabItem">
                                    <Border BackgroundColor="{Binding BgHex}"
                                            Stroke="{Binding BorderHex}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="14,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnStatusTabTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}"
                                               TextColor="{Binding TextHex}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}" BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="13" />
                </Border>

                <Border IsVisible="{Binding HasStatus}" BackgroundColor="#ECFDF5" Stroke="#A7F3D0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Label Text="{Binding StatusMessage}" TextColor="#047857" FontSize="13" />
                </Border>

                <!-- Khi chưa có đơn hàng nào (giống hệt Views/Customer/Orders.cshtml dòng 9-12) -->
                <Border IsVisible="{Binding IsEmpty}" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18" Padding="24,36">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="Bạn chưa có đơn hàng nào" FontFamily="OpenSansSemibold" FontSize="18"
                               TextColor="#102C46" HorizontalTextAlignment="Center" />
                        <Button Text="Mua sắm ngay" Clicked="OnShopNowClicked"
                                BackgroundColor="#0F766E" TextColor="White" FontFamily="OpenSansSemibold"
                                FontSize="14" CornerRadius="12" HeightRequest="44" Padding="24,0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Danh sách thẻ đơn hàng (order-card giống hệt Views/Customer/Orders.cshtml dòng 13-85) -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderMasterCard">
                            <Border BackgroundColor="White" Stroke="{Binding BorderColorHex}" StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnOrderCardTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="14">

                                    <!-- 1. Order Head: Mã đơn · Ngày đặt + Pill Trạng thái đơn & Pill Thanh toán -->
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Code}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#102C46" VerticalOptions="Center" />
                                            <Label Text="{Binding DateText}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Border BackgroundColor="{Binding StatusBgHex}" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10" Padding="8,4">
                                                <Label Text="{Binding StatusLabel}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding StatusColorHex}" />
                                            </Border>
                                            <Border BackgroundColor="{Binding PaymentBadgeBgHex}" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10" Padding="8,4">
                                                <Label Text="{Binding PaymentStatusLabel}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding PaymentBadgeTextHex}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- 2. Progress Steps (4 bước: Chờ xác nhận -> Đang chuẩn bị -> Đang giao -> Đã giao) -->
                                    <Grid IsVisible="{Binding ShowProgress}" ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Padding="0,2">
                                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Border BackgroundColor="{Binding Step1BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                                                <Label Text="{Binding Step1Icon}" FontFamily="OpenSansSemibold" FontSize="11"
                                                       TextColor="{Binding Step1TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Chờ xác nhận" FontSize="10" TextColor="{Binding Step1LabelHex}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                            <Border BackgroundColor="{Binding Step2BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                                                <Label Text="{Binding Step2Icon}" FontFamily="OpenSansSemibold" FontSize="11"
                                                       TextColor="{Binding Step2TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Đang chuẩn bị" FontSize="10" TextColor="{Binding Step2LabelHex}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                            <Border BackgroundColor="{Binding Step3BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                                                <Label Text="{Binding Step3Icon}" FontFamily="OpenSansSemibold" FontSize="11"
                                                       TextColor="{Binding Step3TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Đang giao" FontSize="10" TextColor="{Binding Step3LabelHex}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                                            <Border BackgroundColor="{Binding Step4BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                                                <Label Text="{Binding Step4Icon}" FontFamily="OpenSansSemibold" FontSize="11"
                                                       TextColor="{Binding Step4TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Đã giao" FontSize="10" TextColor="{Binding Step4LabelHex}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Hoặc thông báo Đơn đã hủy -->
                                    <Border IsVisible="{Binding ShowCancelledAlert}" BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10" Padding="12,8">
                                        <Label Text="{Binding CancelledAlertText}" FontSize="12" TextColor="#B91C1C" FontFamily="OpenSansSemibold" />
                                    </Border>

                                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                                    <!-- 3. Order Lines (các dòng sản phẩm trong đơn giống hệt Views/Customer/Orders.cshtml dòng 36-45) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderSubLineItem">
                                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 10" WidthRequest="52" HeightRequest="52">
                                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding NameAndVariantText}" FontFamily="OpenSansSemibold" FontSize="13"
                                                               TextColor="#102C46" MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding PriceTimesQtyText}" FontSize="12" TextColor="#64748B" />
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold"
                                                           FontSize="13" TextColor="#102C46" VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                                    <!-- 4. Order Foot: Thông tin người nhận, vận đơn, hóa đơn, tổng tiền và nút Hủy đơn -->
                                    <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="10" RowSpacing="6">
                                        <Label Grid.Row="0" Text="Giao đến" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ReceiverName}" FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="#102C46" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />

                                        <Label Grid.Row="1" Text="Số điện thoại" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverPhone}" FontSize="12"
                                               TextColor="#102C46" HorizontalTextAlignment="End" />

                                        <Label Grid.Row="2" Text="Địa chỉ" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReceiverAddress}" FontSize="12"
                                               TextColor="#102C46" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />

                                        <Label Grid.Row="3" Text="Giảm giá" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding DiscountText}" FontSize="12"
                                               TextColor="#DC2626" HorizontalTextAlignment="End" />

                                        <Label Grid.Row="4" Text="Phí giao hàng" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding ShippingFeeText}" FontSize="12"
                                               TextColor="#102C46" HorizontalTextAlignment="End" />

                                        <Label Grid.Row="5" Text="Thanh toán" FontSize="12" TextColor="#64748B" />
                                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding PaymentMethod}" FontSize="12"
                                               TextColor="#102C46" HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Label IsVisible="{Binding HasShippingTracking}" Text="{Binding ShippingTrackingLineText}" FontSize="12" TextColor="#0F766E" />
                                    <Label IsVisible="{Binding HasInvoice}" Text="{Binding InvoiceLineText}" FontSize="12" TextColor="#64748B" />

                                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding TotalLabelText}" FontFamily="OpenSansSemibold" FontSize="16"
                                               TextColor="#0F766E" VerticalOptions="Center" />

                                        <Button Grid.Column="1" IsVisible="{Binding CanCancel}"
                                                Text="Hủy đơn" CommandParameter="{Binding .}" Clicked="OnCancelOrderCardClicked"
                                                BackgroundColor="#F1F5F9" TextColor="#DC2626" FontFamily="OpenSansSemibold"
                                                FontSize="13" CornerRadius="10" HeightRequest="38" Padding="16,0" VerticalOptions="Center" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
