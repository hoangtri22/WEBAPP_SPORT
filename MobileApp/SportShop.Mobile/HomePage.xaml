<?xml version="1.0" encoding="utf-8" ?>
<!-- Trang chủ, tương ứng Views/Home/Index.cshtml của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.HomePage" x:DataType="vm:HomeViewModel"
             NavigationPage.HasNavigationBar="False" Title="Trang chủ">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="16,10,8,10" BackgroundColor="White">
            <controls:BrandLogo />
            <ImageButton Grid.Column="1" Source="ic_tag_teal.png" Style="{StaticResource IconAction}"
                         SemanticProperties.Description="Khuyến mãi" Clicked="OnPromotionsClicked" />
        </Grid>
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView x:Name="HomeScroll" Loaded="OnHomeScrollReady" SizeChanged="OnHomeScrollReady">
                <VerticalStackLayout Spacing="24" Padding="0,0,0,28">
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16,4,16,16">
                        <Border Style="{StaticResource FieldBox}" BackgroundColor="{StaticResource Bg}" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HeightRequest="48">
                                <Image Source="ic_search_muted.png" Style="{StaticResource FieldIcon}" />
                                <Label Grid.Column="1" Text="Tìm giày, quần áo, phụ kiện…" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <Border Margin="16,0" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="20,22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Teal}" Offset="0" />
                                <GradientStop Color="{StaticResource TealDark}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="ic_sparkles_white.png" WidthRequest="14" HeightRequest="14" />
                                <Label Text="BỘ SƯU TẬP MỚI 2025" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" TextColor="{StaticResource TealSoft}" />
                            </HorizontalStackLayout>
                            <Label FontFamily="OpenSansSemibold" FontSize="28" LineHeight="1.1" TextColor="White">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Chuyển động&#10;" />
                                        <Span Text="theo cách của bạn." TextColor="#FDBA74" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Trang bị tốt hơn cho từng bước chạy. Khám phá những thiết kế mới nhất." FontSize="13" TextColor="{StaticResource TealSoft}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                <Button Text="Mua sắm ngay" Clicked="OnCatalogClicked" Style="{StaticResource AccentButton}" HeightRequest="48" FontSize="14" />
                                <Button Grid.Column="1" Text="Xem ưu đãi" Clicked="OnPromotionsClicked" BackgroundColor="#1AFFFFFF"
                                        BorderColor="#66FFFFFF" BorderWidth="1" TextColor="White" CornerRadius="14" HeightRequest="48" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="16,0">
                            <Border Style="{StaticResource Card}" Padding="12" WidthRequest="168">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_truck_teal.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Giao hàng miễn phí" Style="{StaticResource BenefitTitle}" />
                                        <Label Text="Đơn hàng từ 500.000₫" Style="{StaticResource SmallMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="12" WidthRequest="168">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_shield_check_teal.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Chính hãng" Style="{StaticResource BenefitTitle}" />
                                        <Label Text="Cam kết hoàn tiền" Style="{StaticResource SmallMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="12" WidthRequest="168">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_activity_teal.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Đổi trả 30 ngày" Style="{StaticResource BenefitTitle}" />
                                        <Label Text="Nhanh chóng, dễ dàng" Style="{StaticResource SmallMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="12" WidthRequest="168">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_headphones_teal.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Hỗ trợ tận tâm" Style="{StaticResource BenefitTitle}" />
                                        <Label Text="Từ 8:00 đến 22:00" Style="{StaticResource SmallMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Border IsVisible="{Binding HasError}" Style="{StaticResource AlertError}" Margin="16,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Thử lại" Clicked="OnRefreshClicked" IsEnabled="{Binding IsIdle}" Style="{StaticResource GhostButton}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="CHỌN THEO NHU CẦU" Style="{StaticResource Eyebrow}" />
                                <Label Text="Danh mục sản phẩm" Style="{StaticResource SectionTitle}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Tất cả" Clicked="OnCatalogClicked" Style="{StaticResource GhostButton}" VerticalOptions="End" />
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10" Padding="16,0" BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomeCategory">
                                        <Border Style="{StaticResource Card}" Padding="14" WidthRequest="140">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding Id}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="10">
                                                <Border BackgroundColor="{Binding Tint}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                        WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" Padding="11">
                                                    <Image Source="{Binding Icon}" />
                                                </Border>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding CountText}" Style="{StaticResource SmallMuted}" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TỪ CỬA HÀNG" Style="{StaticResource Eyebrow}" />
                                <Label Text="Sản phẩm mới nhất" Style="{StaticResource SectionTitle}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Xem thêm" Clicked="OnCatalogClicked" Style="{StaticResource GhostButton}" VerticalOptions="End" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsInitialLoading}" Spacing="10" Padding="0,24">
                            <ActivityIndicator IsRunning="{Binding IsInitialLoading}" />
                            <Label Text="Đang tải sản phẩm…" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <controls:EmptyState IsVisible="{Binding ShowEmpty}" Icon="ic_package_teal.png"
                                             Title="Chưa có sản phẩm" Message="Cửa hàng đang cập nhật sản phẩm, vui lòng quay lại sau." />
                        <FlexLayout Wrap="Wrap" Direction="Row" Padding="11,0" BindableLayout.ItemsSource="{Binding Products}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductCard">
                                    <ContentView FlexLayout.Basis="50%" Padding="5">
                                        <Border Style="{StaticResource Card}" SemanticProperties.Description="{Binding AccessibilityDescription}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Grid HeightRequest="150" BackgroundColor="{StaticResource TealTint}">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="10" />
                                                    <Border IsVisible="{Binding IsSoldOut}" BackgroundColor="{StaticResource Ink}" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                            Padding="8,3" Margin="8" HorizontalOptions="Start" VerticalOptions="Start">
                                                        <Label Text="Hết hàng" TextColor="White" FontSize="10" FontFamily="OpenSansSemibold" />
                                                    </Border>
                                                </Grid>
                                                <VerticalStackLayout Padding="12,10,12,12" Spacing="4">
                                                    <Label Text="{Binding CategoryName}" Style="{StaticResource SmallMuted}" FontSize="11" MaxLines="1" />
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="38" />
                                                    <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" FontSize="15" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Border Margin="16,0" BackgroundColor="{StaticResource Ink}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPromotionsClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="ƯU ĐÃI DÀNH CHO BẠN" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Orange}" />
                                <Label Text="Chạy xa hơn.&#10;Tiết kiệm nhiều hơn." FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" />
                                <Label Text="Xem mã giảm giá đang hiệu lực và điều kiện áp dụng." FontSize="12" TextColor="#CBD5E1" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Orange}" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                    WidthRequest="48" HeightRequest="48" Padding="13" VerticalOptions="Center">
                                <Image Source="ic_chevron_right_white.png" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="16,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInfoClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource TealSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="44" HeightRequest="44" Padding="11">
                                <Image Source="ic_headphones_teal.png" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Hỗ trợ khách hàng" Style="{StaticResource CardTitle}" />
                                <Label Text="Đổi trả, giao hàng, chọn size, liên hệ" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="ic_chevron_right_muted.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
