@model List<PromoInfo>
@{
    ViewData["Title"] = "Khuyến mãi";
}
<section class="shop-page">
    <div class="shop-page-head">
        <span class="eyebrow">ƯU ĐÃI</span>
        <h1>Khuyến mãi đang diễn ra</h1>
        <p>Nhập mã ở bước thanh toán để được giảm giá.</p>
    </div>
    @if (Model.Count == 0)
    {
        <div class="shop-empty"><h2>Hiện chưa có chương trình khuyến mãi nào</h2></div>
    }
    else
    {
        <div class="promo-grid">
            @foreach (var p in Model)
            {
                <div class="promo-card">
                    <div class="promo-code">@p.Code</div>
                    <h3>@p.Name</h3>
                    <p>Giảm <b>@p.Percent.ToString("0.##")%</b>@(p.MaxDiscount.HasValue ? $", tối đa {Fmt.Money(p.MaxDiscount.Value)}" : "")</p>
                    <small>@(string.IsNullOrEmpty(p.Tier) ? "Áp dụng cho mọi hạng thành viên" : "Dành cho thành viên hạng " + p.Tier) · Hết hạn @Fmt.Date(p.End)</small>
                </div>
            }
        </div>
    }
</section>
