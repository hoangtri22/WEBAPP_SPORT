@model SurveyPageVm
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Khảo sát khách hàng";
    var cur = Model.Current;
    var qs = Model.Questions;
    var pending = Model.Items.Where(s => !s.Done && s.IsOpen).ToList();
    int doneCount = Model.Items.Count(s => s.Done);
}

@if (Model.JustDone)
{
    <div class="card survey-thanks">
        <div>@Icons.Svg("check-circle", 34)</div>
        <span>HOÀN TẤT KHẢO SÁT</span>
        <h1>Cảm ơn bạn đã hoàn thành khảo sát!</h1>
        <p>Ý kiến của bạn là dữ liệu quý giá để SPORTSHOP tạo nên trải nghiệm tốt hơn mỗi ngày.</p>
        <a class="btn btn-primary" asp-action="Surveys">@Icons.Svg("arrow-left", 17) Quay lại danh sách khảo sát</a>
    </div>
}
else if (cur == null)
{
    <div class="customer-page-title"><span>TIẾNG NÓI KHÁCH HÀNG</span><h1>Khảo sát khách hàng</h1><p>Các khảo sát được SPORTSHOP gửi riêng đến tài khoản của bạn.</p></div>
    <div class="survey-summary">
        <div>@Icons.Svg("clipboard-check", 21)<span><strong>@pending.Count.ToString("00") khảo sát đang chờ</strong><small>Mất khoảng 3–5 phút để hoàn thành</small></span></div>
        <span>Đã hoàn thành <b>@doneCount</b> khảo sát</span>
    </div>
    <div class="survey-list">
        @foreach (var s in Model.Items)
        {
            if (s.Done)
            {
                <article class="survey-card completed">
                    <div class="survey-card-icon">@Icons.Svg("check-circle", 25)</div>
                    <div class="survey-card-copy">
                        <div><span class="state">ĐÃ HOÀN THÀNH</span><small>@s.CompletedAt?.ToString("dd/MM/yyyy")</small></div>
                        <h2>@s.Title</h2>
                        <p>@s.Description</p>
                    </div>
                    <span class="pill p-g"><i></i>Đã gửi</span>
                </article>
            }
            else if (s.IsOpen)
            {
                <article class="survey-card featured">
                    <div class="survey-card-icon">@Icons.Svg("clipboard-list", 25)</div>
                    <div class="survey-card-copy">
                        <div><span class="state">ĐANG DIỄN RA</span><small>@Icons.Svg("calendar-clock", 14) Hạn: @s.Deadline.ToString("dd/MM/yyyy")</small></div>
                        <h2>@s.Title</h2>
                        <p>@s.Description</p>
                        <div class="survey-meta"><span>@s.QuestionCount câu hỏi</span><span>Khoảng @Math.Max(1, s.QuestionCount) phút</span></div>
                    </div>
                    <a class="btn btn-primary" asp-action="Surveys" asp-route-id="@s.Id">Thực hiện khảo sát @Icons.Svg("chevron-right", 17)</a>
                </article>
            }
            else
            {
                <article class="survey-card completed">
                    <div class="survey-card-icon">@Icons.Svg("calendar-clock", 25)</div>
                    <div class="survey-card-copy">
                        <div><span class="state">ĐÃ HẾT HẠN</span><small>@s.Deadline.ToString("dd/MM/yyyy")</small></div>
                        <h2>@s.Title</h2>
                        <p>@s.Description</p>
                    </div>
                    <span class="pill p-b"><i></i>Hết hạn</span>
                </article>
            }
        }
        @if (Model.Items.Count == 0)
        {
            <div class="empty">Hiện chưa có khảo sát nào được gửi đến tài khoản của bạn.</div>
        }
    </div>
}
else
{
    <a class="back-link" asp-action="Surveys">@Icons.Svg("arrow-left", 17) Danh sách khảo sát</a>
    <form class="card survey-form" method="post" asp-action="Surveys" asp-route-id="@cur.Id" id="surveyForm">
        <div class="survey-progress-head">
            <div><span>@cur.Title.ToUpper()</span><h1>Hiểu bạn hơn, phục vụ tốt hơn</h1></div>
            <b id="stepNo">1/@qs.Count</b>
        </div>
        <div class="progress-track"><i id="progress"></i></div>

        @for (int i = 0; i < qs.Count; i++)
        {
            var q = qs[i];
            <div class="survey-question" data-step="@i" data-required="@(q.Required ? "true" : "false")" hidden>
                <span>CÂU HỎI @((i + 1).ToString("00"))@(q.Required ? " · BẮT BUỘC" : "")</span>
                <h2>@q.Title</h2>
                <p>@(q.Type switch { "many" => "Có thể chọn nhiều phương án.", "text" => "Nhập câu trả lời của bạn.", "scale" => "Chọn mức điểm từ thấp đến cao.", _ => "Chọn phương án phù hợp nhất với bạn." })</p>
                @if (q.Type == "text")
                {
                    <textarea name="q@(q.Id)" maxlength="500" placeholder="Nhập câu trả lời của bạn..."></textarea>
                }
                else
                {
                    <div class="survey-options @(q.Type == "scale" ? "scale" : "")">
                        @foreach (var o in q.Options)
                        {
                            <label><input type="@(q.Type == "many" ? "checkbox" : "radio")" name="q@(q.Id)" value="@o.Id" /><span>@o.Text</span></label>
                        }
                    </div>
                }
                <small class="survey-hint" hidden>Vui lòng trả lời câu hỏi trước khi tiếp tục.</small>
            </div>
        }

        <div class="survey-actions">
            <button type="button" class="btn btn-secondary" id="prevQ">@Icons.Svg("chevron-left", 17) Câu trước</button>
            <span>Câu hỏi bắt buộc được ghi "BẮT BUỘC"</span>
            <button type="button" class="btn btn-primary" id="nextQ"><b>Câu tiếp theo</b> @Icons.Svg("chevron-right", 17)</button>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('surveyForm');
            if (!form) return;
            var steps = form.querySelectorAll('.survey-question'), total = steps.length, step = 0;
            if (total === 0) return;
            var next = document.getElementById('nextQ'), prev = document.getElementById('prevQ');

            function answered(i) {
                var s = steps[i], t = s.querySelector('textarea');
                if (t) return t.value.trim() !== '';
                return s.querySelectorAll('input:checked').length > 0;
            }
            function show(n) {
                step = n;
                steps.forEach(function (s, i) { s.hidden = i !== n; });
                document.getElementById('stepNo').textContent = (n + 1) + '/' + total;
                document.getElementById('progress').style.width = ((n + 1) / total * 100) + '%';
                next.querySelector('b').textContent = n === total - 1 ? 'Gửi khảo sát' : 'Câu tiếp theo';
                steps[n].querySelector('.survey-hint').hidden = true;
            }
            prev.addEventListener('click', function () { if (step > 0) show(step - 1); });
            next.addEventListener('click', function () {
                if (steps[step].dataset.required === 'true' && !answered(step)) { steps[step].querySelector('.survey-hint').hidden = false; return; }
                if (step < total - 1) { show(step + 1); return; }
                if (document.body.dataset.db !== 'true') { showToast(); return; }
                next.disabled = true;
                form.submit();
            });
            show(0);
        })();
    </script>
}
