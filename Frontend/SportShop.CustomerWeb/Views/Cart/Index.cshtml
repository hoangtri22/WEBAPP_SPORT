@model CartPageVm
@{
    ViewData["Title"] = "Giỏ hàng";
    var lines = Model.Lines;
    decimal subtotal = lines.Sum(l => l.Amount);
    decimal ship = ShopStore.ShippingFor(subtotal);
    decimal discount = Math.Min(Model.Applied?.Discount ?? 0, subtotal);
}
<section class="shop-page">
    <div class="shop-page-head"><span class="eyebrow">GIỎ HÀNG</span><h1>Giỏ hàng của bạn</h1></div>
    @if (lines.Count == 0)
    {
        <div class="shop-empty">
            @Icons.Svg("shopping-bag", 40)
            <h2>Giỏ hàng đang trống</h2>
            <p>Hãy chọn vài món đồ bạn thích nhé.</p>
            <a class="btn btn-primary" asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-main">
            <div class="card cart-list">
                @foreach (var l in lines)
                {
                    <div class="cart-row">
                        <a class="cart-img" asp-controller="Shop" asp-action="Detail" asp-route-id="@l.ProductId">@if (!string.IsNullOrEmpty(l.Image)) { <img src="@l.Image" alt="" onerror="this.style.visibility='hidden'" /> }</a>
                        <div class="cart-info">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@l.ProductId"><strong>@l.Name</strong></a>
                            @if (!string.IsNullOrEmpty(l.Label)) { <small>@l.Label</small> }
                            <span class="cart-price">@Fmt.Money(l.Price)</span>
                            @if (!l.Enough) { <span class="cart-warn">Chỉ còn @l.Stock sản phẩm trong kho</span> }
                        </div>
                        <form method="post" asp-action="Update" class="cart-qty">
                            <input type="hidden" name="variantId" value="@l.VariantId" />
                            <input type="number" name="qty" value="@l.Qty" min="1" max="@l.Stock" onchange="this.form.submit()" aria-label="Số lượng" />
                        </form>
                        <div class="cart-amount">@Fmt.Money(l.Amount)</div>
                        <form method="post" asp-action="Remove">
                            <input type="hidden" name="variantId" value="@l.VariantId" />
                            <button class="icon-square" title="Bỏ khỏi giỏ">@Icons.Svg("x", 16)</button>
                        </form>
                    </div>
                }
            </div>
            @if (Model.Upsell is { } up)
            {
                <section class="card cart-upsell">
                    <div class="cart-upsell-head">
                        @Icons.Svg("sparkles", 20)
                        <div>
                            <strong>Mua thêm @Fmt.Money(up.Missing) để được giảm @up.Percent.ToString("0.##")%</strong>
                            <small>@up.Name: tiết kiệm đến @Fmt.Money(up.Discount), tự áp dụng khi thanh toán.</small>
                        </div>
                    </div>
                    <div class="cart-upsell-list">
                        @foreach (var p in up.Items)
                        {
                            <div class="cart-upsell-item">
                                <a class="cart-img" asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId" aria-label="@p.Name">@if (!string.IsNullOrEmpty(p.Image)) { <img src="@p.Image" alt="@p.Name" loading="lazy" /> }</a>
                                <div>
                                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId"><strong>@p.Name</strong></a>
                                    <span class="cart-price">@Fmt.Money(p.Price)</span>
                                </div>
                                @if (p.VariantId is int variant)
                                {
                                    <form method="post" asp-action="Add">
                                        <input type="hidden" name="variantId" value="@variant" />
                                        <input type="hidden" name="back" value="/Cart" />
                                        <button class="btn btn-secondary">Thêm vào giỏ</button>
                                    </form>
                                }
                                else { <a class="btn btn-secondary" asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId">Chọn mua</a> }
                            </div>
                        }
                    </div>
                </section>
            }
            </div>
            <aside class="card cart-summary">
                <h3>Tóm tắt đơn hàng</h3>
                <div class="sum-row"><span>Tạm tính</span><b>@Fmt.Money(subtotal)</b></div>
                @if (Model.Applied is { } applied) { <div class="sum-row"><span>Giảm theo đơn</span><b>-@Fmt.Money(discount)</b></div> }
                <div class="sum-row"><span>Phí giao hàng</span><b>@(ship == 0 ? "Miễn phí" : Fmt.Money(ship))</b></div>
                <div class="sum-row total"><span>Tổng cộng</span><b>@Fmt.Money(subtotal - discount + ship)</b></div>
                <small class="muted">Mã giảm giá được chọn ở bước thanh toán và thay cho mức giảm theo đơn.</small>
                @if (lines.Any(l => !l.Enough)) { <p class="cart-warn">Vui lòng giảm số lượng các sản phẩm vượt tồn kho.</p> }
                else { <a class="btn btn-primary" asp-action="Checkout">Tiến hành thanh toán</a> }
                <a class="btn btn-secondary" asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
            </aside>
        </div>
    }
</section>
