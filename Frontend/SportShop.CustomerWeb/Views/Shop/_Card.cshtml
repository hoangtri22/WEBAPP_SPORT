@model ShopProduct
<article class="shop-product-card" id="sp@(Model.Id)">
    <div class="shop-product-image">
        <a class="image-link" asp-controller="Shop" asp-action="Detail" asp-route-id="@Model.Id" aria-label="@Model.Name"></a>
        @if (!string.IsNullOrEmpty(Model.Image)) { <img src="@Model.Image" alt="@Model.Name" loading="lazy" onerror="this.style.visibility='hidden'" /> }
        @if (Model.Stock <= 0) { <span class="badge">Hết hàng</span> }
        <a class="quick-add has-cart" asp-controller="Shop" asp-action="Detail" asp-route-id="@Model.Id">@Icons.Svg("shopping-bag", 16) Chọn mua</a>
        <form method="post" class="quick-cart-form" asp-controller="Cart" asp-action="QuickAdd">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="back" value="@(Context.Request.Path + Context.Request.QueryString + "#sp" + Model.Id)" />
            <button type="submit" class="quick-cart" aria-label="Thêm vào giỏ hàng">@Icons.Svg("shopping-cart", 18)</button>
        </form>
    </div>
    <div class="shop-product-info">
        <div><span>@Model.Category</span></div>
        <h3><a asp-controller="Shop" asp-action="Detail" asp-route-id="@Model.Id">@Model.Name</a></h3>
        <p><strong>@Model.PriceText</strong></p>
    </div>
</article>
