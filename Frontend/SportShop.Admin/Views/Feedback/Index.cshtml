@model FeedbackVm
@{
    ViewData["Title"] = "Phản hồi khách hàng";
    var pending = Model.Items.Where(f => !f.Answered).ToList();
    var answered = Model.Items.Where(f => f.Answered).ToList();

    // Dữ liệu lọc của từng phản hồi (thuộc tính data-f): loại, trạng thái xử lý, số sao, ngày gửi, người xử lý.
    string F(FeedbackItem f) => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["type"] = Fmt.FeedbackType(f.Type),
        ["status"] = f.Answered ? "Đã trả lời" : f.Status == "dang_xu_ly" ? "Đang xử lý" : "Chưa trả lời",
        ["stars"] = f.Stars?.ToString() ?? "",
        ["date"] = f.SentAt.ToString("yyyy-MM-dd"),
        ["handler"] = f.ReplyEmployeeId is int emp && Model.EmployeeNames.TryGetValue(emp, out var empName) ? empName : "",
    });
    var fbFilter = new FilterSpec
    {
        Id = "feedback", Noun = "phản hồi",
        Fields =
        [
            new("type", "Loại phản hồi", "select", Data: "type"),
            new("status", "Trạng thái xử lý", "select", Data: "status", Options: ["Chưa trả lời", "Đang xử lý", "Đã trả lời"]),
            new("stars", "Số sao đánh giá", "number", Data: "stars"),
            new("date", "Ngày gửi", "date", Data: "date"),
            new("handler", "Người xử lý", "select", Data: "handler"),
        ],
        Quick = [new("Chưa xử lý", "status", "eq", "Chưa trả lời"), new("Khiếu nại", "type", "eq", "Khiếu nại"), new("Dưới 3 sao", "stars", "lte", "2")],
    };

    // Lấy chữ cái đầu của họ và tên khách.
    string Initials(Customer c) => (string.IsNullOrWhiteSpace(c.LastName) ? "" : c.LastName.Trim()[..1]) + (string.IsNullOrWhiteSpace(c.FirstName) ? "" : c.FirstName.Trim()[..1]) is { Length: > 0 } s ? s : "?";
    // Nhãn trạng thái của phản hồi.
    string StatusPill(FeedbackItem f) => f.Answered ? "[g]Đã trả lời" : f.Status == "dang_xu_ly" ? "[b]Đang xử lý" : "[o]Chưa trả lời";
}
<div class="page-head">
    <div>
        <div class="eyebrow">SPORTSHOP ADMIN</div>
        <h1 class="page-title">Phản hồi khách hàng</h1>
        <p class="page-sub">Lắng nghe và hỗ trợ khách hàng</p>
    </div>
</div>

<div class="tabs" id="fbTabs">
    <button type="button" class="tab active" data-tab="pending">Chưa trả lời <span class="tab-count">@pending.Count</span></button>
    <button type="button" class="tab" data-tab="answered">Đã trả lời <span class="tab-count gray">@answered.Count</span></button>
</div>

<section class="card adv-host" id="fbCard" data-filter="@System.Text.Json.JsonSerializer.Serialize(fbFilter, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })">
    <div class="toolbar">
        <button type="button" class="btn-outline js-adv" id="fbAdvBtn" aria-expanded="false">@Icons.Svg("sliders", 18) Tìm kiếm nâng cao <span class="adv-count">0</span></button>
    </div>
    <div class="adv-panel" id="fbAdv" hidden></div>
</section>

<div class="inbox card">
    <div class="inbox-list">
        <label class="search">
            @Icons.Svg("search", 18)
            <input type="search" id="fbSearch" placeholder="Tìm phản hồi..." autocomplete="off" />
            <kbd>Ctrl K</kbd>
        </label>
        <div id="fbItems">
            @foreach (var f in Model.Items)
            {
                var c = Model.Customers[f.CustomerId];
                bool isPending = !f.Answered;
                <button type="button" class="msg @(f == pending.FirstOrDefault() ? "active" : "")" data-id="@f.Id" data-group="@(isPending ? "pending" : "answered")" data-f="@F(f)"
                        data-text="@(c.FullName + " " + f.Title + " " + f.Body)" @(isPending ? "" : "hidden")>
                    <span class="avatar sm">@Initials(c)</span>
                    <span class="msg-main">
                        <span class="msg-top"><b>@c.FullName</b><small>@Fmt.Ago(f.SentAt)</small></span>
                        <span class="msg-title">@f.Title</span>
                        <span class="msg-prev">@f.Body</span>
                    </span>
                </button>
            }
        </div>
        <div class="empty" id="fbEmpty" hidden>Không có phản hồi nào</div>
    </div>

    <div class="inbox-detail">
        @foreach (var f in Model.Items)
        {
            var c = Model.Customers[f.CustomerId];
            <article class="detail" data-id="@f.Id" @(f == pending.FirstOrDefault() ? "" : "hidden")>
                <header class="detail-head">
                    <span class="avatar">@Initials(c)</span>
                    <div>
                        <b>@c.FullName</b>
                        <small>Hạng @c.Tier · #KH@(c.Id.ToString("D4"))</small>
                    </div>
                    <span class="grow"></span>
                    @Fmt.Cell(StatusPill(f))
                </header>
                <div class="detail-body">
                    <div class="eyebrow">NỘI DUNG PHẢN HỒI</div>
                    <h2>@f.Title</h2>
                    <div class="detail-tags">
                        @Fmt.Cell("[x]" + Fmt.FeedbackType(f.Type))
                        @if (f.Stars.HasValue)
                        {
                            <span class="stars">@for (int i = 1; i <= 5; i++) { <span class="@(i <= f.Stars ? "on" : "")">@Icons.Svg("star", 16)</span> }</span>
                        }
                        @if (f.Target != null) { <span class="muted">· @f.Target</span> }
                        @if (!f.Visible) { @Fmt.Cell("[r]Đã ẩn") }
                    </div>
                    <p>@f.Body</p>
                    <small class="muted">Gửi lúc @f.SentAt.ToString("HH:mm, dd/MM/yyyy")</small>

                    @if (f.Reply != null)
                    {
                        <div class="reply-box done">
                            <div class="eyebrow">CÂU TRẢ LỜI</div>
                            <p>@f.Reply</p>
                            <small class="muted">@(f.ReplyEmployeeId.HasValue ? Model.EmployeeNames[f.ReplyEmployeeId.Value] : "") · @(f.ReplyAt.HasValue ? f.ReplyAt.Value.ToString("HH:mm, dd/MM/yyyy") : "")</small>
                        </div>
                    }
                    else
                    {
                        <div class="reply-box">
                            <div class="eyebrow">TRẢ LỜI PHẢN HỒI</div>
                            <textarea rows="4" placeholder="Nhập nội dung trả lời khách hàng..."></textarea>
                            <div class="reply-actions">
                                <button type="button" class="btn-outline" data-act="feedback_toggle" data-id="@f.Id">@(f.Visible ? "Ẩn phản hồi" : "Hiện phản hồi")</button>
                                <button type="button" class="btn-primary" data-act="feedback_reply" data-id="@f.Id">@Icons.Svg("send", 18) Gửi trả lời</button>
                            </div>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Hộp thư phản hồi: chuyển tab, chọn phản hồi, tìm kiếm trên trình duyệt; nút "Gửi trả lời" (data-act="feedback_reply") gửi qua admin.js đến /Crud/Act.
        (function () {
            var items = Array.prototype.slice.call(document.querySelectorAll('#fbItems .msg'));
            var details = Array.prototype.slice.call(document.querySelectorAll('.inbox-detail .detail'));
            var tab = 'pending';

            function select(id) {
                items.forEach(function (m) { m.classList.toggle('active', m.dataset.id === id); });
                details.forEach(function (d) { d.hidden = d.dataset.id !== id; });
            }

            function render() {
                var q = document.getElementById('fbSearch').value;
                var first = null, shown = 0;
                items.forEach(function (m) {
                    var ok = m.dataset.group === tab && SearchKit.matches(m.dataset.text, q) && adv.matches(m);
                    m.hidden = !ok;
                    if (ok) shown++;
                    if (ok && !first) first = m;
                });
                document.getElementById('fbEmpty').hidden = !!first;
                adv.setResult(shown);
                details.forEach(function (d) { d.hidden = true; });
                if (first) select(first.dataset.id);
            }

            items.forEach(function (m) { m.addEventListener('click', function () { select(m.dataset.id); }); });
            document.querySelectorAll('#fbTabs .tab').forEach(function (t) {
                t.addEventListener('click', function () {
                    document.querySelectorAll('#fbTabs .tab').forEach(function (x) { x.classList.toggle('active', x === t); });
                    tab = t.dataset.tab; render();
                });
            });
            // Bộ lọc nâng cao theo mẫu thiết kế: áp cùng lúc với tab và ô tìm kiếm.
            var adv = SearchKit.filterPanel(document.getElementById('fbAdvBtn'), document.getElementById('fbAdv'), items,
                JSON.parse(document.getElementById('fbCard').dataset.filter), function () { render(); });
            document.getElementById('fbSearch').addEventListener('input', render);
            render();
        })();
    </script>
}
