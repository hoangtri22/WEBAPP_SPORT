{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Địa chỉ web quản trị (SportShop.Admin). Nút "Trang quản trị" trên web khách hàng sẽ chuyển tới đây.
  // Khi đưa lên máy chủ thật chỉ cần đổi địa chỉ này.
  "Links": {
    "AdminUrl": "http://localhost:5188"
  },

  // Chuỗi kết nối MySQL. Để trống = chưa có cơ sở dữ liệu (các chức năng sẽ hiện thông báo).
  // Mỗi máy tự điền riêng, ví dụ:
  //   "Server=localhost;Port=3306;Database=sportshop;User=root;Password=...;"
  "ConnectionStrings": {
    "Default": ""
  }
}
