<?xml version="1.0" encoding="utf-8" ?>
<!-- Trang thông tin và hỗ trợ, tương ứng Views/Info/Page.cshtml và các liên kết chân trang của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:services="clr-namespace:SportShop.Mobile.Services"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.InfoPagesPage" x:DataType="vm:InfoPagesViewModel"
             Title="Thông tin và hỗ trợ">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28" Spacing="14">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <controls:EmptyState IsVisible="{Binding HasError}" IsError="True" Icon="ic_wifi_off_muted.png" Title="Chưa tải được nội dung"
                                 Message="{Binding ErrorMessage}" ActionText="Thử lại" ActionClicked="OnRetryClicked" AutomationId="InfoError" />
            <VerticalStackLayout IsVisible="{Binding ShowList}" Spacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="HỖ TRỢ KHÁCH HÀNG" Style="{StaticResource Eyebrow}" />
                    <Label Text="Thông tin và hỗ trợ" Style="{StaticResource PageTitle}" FontSize="22" />
                    <Label Text="Chính sách, hướng dẫn chọn size và thông tin cửa hàng." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Label Text="Hiện chưa có trang thông tin." IsVisible="{Binding ShowEmpty}" Style="{StaticResource Caption}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pages}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:ContentPageSummary">
                            <Border Style="{StaticResource SectionCard}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                                        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                        <Label Text="{Binding Intro}" Style="{StaticResource SmallMuted}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" ImageSource="ic_chevron_right_teal.png" Clicked="OnPageClicked" BackgroundColor="{StaticResource TealSoft}"
                                            WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22" VerticalOptions="Center"
                                            SemanticProperties.Description="{Binding Title, StringFormat='Xem {0}'}" AutomationId="OpenInfoPage" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding ShowPage}" Spacing="14">
                <Button Text="Tất cả trang thông tin" ImageSource="ic_chevron_left_ink.png" ContentLayout="Left,4" Clicked="OnAllClicked" IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource GhostButton}" TextColor="{StaticResource Ink}" HorizontalOptions="Start" />
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Current.Eyebrow}" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding Current.Title}" Style="{StaticResource PageTitle}" FontSize="22" AutomationId="InfoTitle" />
                        <Label Text="{Binding Current.Intro}" Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Current.Sections}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:ContentSection">
                            <Border Style="{StaticResource SectionCard}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Heading}" Style="{StaticResource CardTitle}" FontSize="16" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Paragraphs}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" Style="{StaticResource BodyText}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
