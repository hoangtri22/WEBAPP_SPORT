<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:catalog="clr-namespace:SportShop.Contracts.Catalog;assembly=SportShop.Contracts"
             x:Class="SportShop.Mobile.HomePage" x:DataType="vm:HomeViewModel"
             BackgroundColor="{StaticResource Bg}" Title="Trang chủ">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="18,12" BackgroundColor="White">
            <Label Text="SPORTSHOP" VerticalOptions="Center" FontFamily="OpenSansSemibold" FontSize="20" CharacterSpacing="1.5" TextColor="{StaticResource Teal}" />
            <ImageButton Grid.Column="1" Source="ic_search_ink.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Tìm kiếm sản phẩm" Clicked="OnCatalogClicked" />
            <ImageButton Grid.Column="2" Source="ic_shopping_bag_ink.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="Giỏ hàng" Clicked="OnCartClicked" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="0,0,0,24">
                <Border BackgroundColor="{StaticResource TealDark}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,22,22" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="CÙNG BẠN VẬN ĐỘNG" FontSize="11" CharacterSpacing="1" TextColor="{StaticResource TealSoft}" />
                        <Label Text="Chuyển động&#10;theo cách của bạn." FontFamily="OpenSansSemibold" FontSize="28" TextColor="White" />
                        <Label Text="Khám phá sản phẩm thể thao và chọn phiên bản phù hợp với bạn." FontSize="13" TextColor="{StaticResource TealSoft}" />
                        <Button Text="Mua sắm ngay" Clicked="OnCatalogClicked" BackgroundColor="{StaticResource Orange}" TextColor="White" CornerRadius="12" />
                        <Button Text="Khám phá ưu đãi →" Clicked="OnPromotionsClicked" BackgroundColor="Transparent" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Padding="18,0">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Image Source="ic_truck_teal.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" />
                            <Label Text="Giao hàng miễn phí" Style="{StaticResource BenefitTitle}" />
                            <Label Text="Đơn hàng từ 500.000₫" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Image Source="ic_shield_check_teal.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" />
                            <Label Text="100% chính hãng" Style="{StaticResource BenefitTitle}" />
                            <Label Text="Đổi trả trong 30 ngày" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <VerticalStackLayout Spacing="8" Padding="18,0">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#B91C1C" />
                    <Button Text="Làm mới sản phẩm" Clicked="OnRefreshClicked" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />
                    <Label Text="Hiện chưa có sản phẩm. Vui lòng quay lại sau." IsVisible="{Binding ShowEmpty}" Style="{StaticResource SmallMuted}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12" Padding="18,0">
                    <Label Text="CHỌN THEO NHU CẦU" Style="{StaticResource Eyebrow}" />
                    <Label Text="Danh mục sản phẩm" Style="{StaticResource SectionTitle}" />
                    <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="catalog:CategoryDto">
                                <Button Text="{Binding Name}" CommandParameter="{Binding Id}" Clicked="OnCategoryClicked"
                                        Margin="0,0,8,8" BackgroundColor="White" TextColor="{StaticResource Teal}"
                                        BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="14" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4" Padding="18,0">
                        <Label Text="TỪ CỬA HÀNG" Style="{StaticResource Eyebrow}" />
                        <Label Text="Sản phẩm mới nhất" Style="{StaticResource SectionTitle}" />
                    </VerticalStackLayout>
                    <FlexLayout Wrap="Wrap" Direction="Row" Padding="13,0" BindableLayout.ItemsSource="{Binding Products}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductCard">
                                <ContentView FlexLayout.Basis="50%" Padding="5">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" HeightRequest="140" Margin="8" SemanticProperties.Description="{Binding Name}" />
                                            <VerticalStackLayout Padding="12" Spacing="5">
                                                <Label Text="{Binding CategoryName}" Style="{StaticResource SmallMuted}" MaxLines="1" />
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="40" />
                                                <Label Text="{Binding PriceText}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Teal}" />
                                                <Label Text="{Binding StockText}" Style="{StaticResource SmallMuted}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Button Text="Xem tất cả sản phẩm" Clicked="OnCatalogClicked" Style="{StaticResource OutlineButton}" Margin="18,0" />
                </VerticalStackLayout>
                <Border Margin="18,0" BackgroundColor="{StaticResource Ink}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ƯU ĐÃI DÀNH CHO BẠN" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Orange}" />
                        <Label Text="Chọn mã khuyến mãi phù hợp" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" />
                        <Label Text="Xem thời hạn và điều kiện áp dụng trước khi dùng mã ở bước thanh toán." FontSize="13" TextColor="#C7D0D8" />
                        <Button Text="Xem khuyến mãi" Clicked="OnPromotionsClicked" BackgroundColor="{StaticResource Orange}" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Padding="18,0" Spacing="10">
                    <Label Text="SPORTSHOP luôn sẵn sàng hỗ trợ bạn" Style="{StaticResource BenefitTitle}" />
                    <Button Text="Chính sách, hướng dẫn và liên hệ" Clicked="OnInfoClicked" Style="{StaticResource OutlineButton}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Padding="8,4" BackgroundColor="White">
            <Button Text="Trang chủ" BackgroundColor="Transparent" TextColor="{StaticResource Teal}" FontSize="11" Padding="0" />
            <Button Grid.Column="1" Text="Sản phẩm" Clicked="OnCatalogClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
            <Button Grid.Column="2" Text="Giỏ hàng" Clicked="OnCartClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
            <Button Grid.Column="3" Text="Tài khoản" Clicked="OnAccountClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
        </Grid>
    </Grid>
</ContentPage>
