<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bảng màu theo biến :root của Frontend/SportShop.CustomerWeb/wwwroot/css/shop.css. -->
    <Color x:Key="Teal">#0F766E</Color>
    <Color x:Key="TealDark">#0B5651</Color>
    <Color x:Key="TealSoft">#E6F1EF</Color>
    <Color x:Key="TealTint">#F1F8F7</Color>
    <Color x:Key="Orange">#F97316</Color>
    <Color x:Key="OrangeSoft">#FFF1E6</Color>
    <Color x:Key="Ink">#0F172A</Color>
    <Color x:Key="InkSoft">#334155</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Line">#E2E8F0</Color>
    <Color x:Key="Bg">#F4F7F6</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerSoft">#FEF2F2</Color>
    <Color x:Key="DangerLine">#FECACA</Color>
    <Color x:Key="Success">#0B7A5A</Color>
    <Color x:Key="SuccessSoft">#DCF5EC</Color>
    <Color x:Key="Warning">#B7791F</Color>
    <Color x:Key="WarningSoft">#FFF1D6</Color>
    <Color x:Key="Info">#2563B8</Color>
    <Color x:Key="InfoSoft">#E3EFFF</Color>

    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryDark">#0B5651</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#E6F1EF</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
</ResourceDictionary>
