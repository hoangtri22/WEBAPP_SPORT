@model HomeVm
@{
    ViewData["Title"] = "Tổng quan";
    var revToday = Model.RevToday; var revYesterday = Model.RevYesterday;
    var ordToday = Model.OrdToday; var ordYesterday = Model.OrdYesterday;

    string VsYesterday(decimal cur, decimal prev) =>
        prev == 0 ? "Hôm qua chưa có dữ liệu" : $"{(cur >= prev ? "+" : "")}{Fmt.Pct(Math.Round((cur - prev) / prev * 100, 1))} so với hôm qua";

    int staffTotal = Model.StaffTotal;
    int staffWorking = Model.StaffWorking;
    int customers = Model.Customers;
    int customersActive = Model.CustomersActive;
    int unanswered = Model.Unanswered;
    int followToday = Model.FollowToday;
    var recent = Model.Recent;
}

<div class="page-head">
    <div>
        <div class="eyebrow">SPORTSHOP ADMIN</div>
        <h1 class="page-title sm">Tổng quan hệ thống</h1>
        <p class="page-sub">Theo dõi hoạt động kinh doanh hôm nay</p>
    </div>
    <a class="btn-primary" asp-controller="Reports" asp-action="Index">@Icons.Svg("bar-chart", 20) Xem báo cáo</a>
</div>

<div class="stats">
    <div class="stat">
        <span class="stat-ico t-teal">@Icons.Svg("circle-dollar-sign", 28)</span>
        <div>
            <div class="stat-label">Doanh thu hôm nay</div>
            <div class="stat-num sm">@Fmt.Compact(revToday)</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) @VsYesterday(revToday, revYesterday)</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
    <div class="stat">
        <span class="stat-ico t-orange">@Icons.Svg("shopping-bag", 28)</span>
        <div>
            <div class="stat-label">Đơn hàng mới</div>
            <div class="stat-num">@ordToday</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) @VsYesterday(ordToday, ordYesterday)</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
    <div class="stat">
        <span class="stat-ico t-blue">@Icons.Svg("user", 28)</span>
        <div>
            <div class="stat-label">Nhân viên</div>
            <div class="stat-num">@staffTotal</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) @staffWorking đang làm việc</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
    <div class="stat">
        <span class="stat-ico t-purple">@Icons.Svg("users", 28)</span>
        <div>
            <div class="stat-label">Khách hàng</div>
            <div class="stat-num">@customers.ToString("N0")</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) @customersActive đang hoạt động</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
    <div class="stat">
        <span class="stat-ico t-pink">@Icons.Svg("message-square", 28)</span>
        <div>
            <div class="stat-label">Phản hồi chưa trả lời</div>
            <div class="stat-num">@unanswered.ToString("00")</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) Cần xử lý sớm</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
    <div class="stat">
        <span class="stat-ico t-yellow">@Icons.Svg("calendar-clock", 28)</span>
        <div>
            <div class="stat-label">Hẹn liên hệ lại hôm nay</div>
            <div class="stat-num">@followToday</div>
            <div class="stat-sub up">@Icons.Svg("trending-up", 15) Theo lịch chăm sóc khách hàng</div>
        </div>
        <button type="button" class="dots " aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
    </div>
</div>

<section class="card">
    <div class="card-head">
        <div>
            <h2>Đơn hàng gần đây</h2>
            <p>Cập nhật theo thời gian thực</p>
        </div>
        <a class="link" asp-controller="Orders" asp-action="Index">Xem tất cả @Icons.Svg("chevron-right", 16)</a>
    </div>
    <div class="table-wrap">
        <table class="tbl">
            <thead><tr><th>Mã HĐ</th><th>Khách hàng</th><th>Ngày lập</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var o in recent)
                {
                    var name = Model.CustomerNames[o.CustomerId];
                    <tr>
                        <td><a class="code" asp-controller="Orders" asp-action="Detail" asp-route-id="@o.Code">@o.Code</a></td>
                        <td><div class="cust"><span class="mini-av">@name.Substring(0, 1)</span><b>@name</b></div></td>
                        <td class="muted">@Fmt.DateTimeDot(o.Date)</td>
                        <td><b>@Fmt.Money(o.Total)</b></td>
                        <td>@Fmt.Cell(Fmt.OrderStatus(o.Status))</td>                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
