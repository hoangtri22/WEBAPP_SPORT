@model TableSection
@{
    var id = ViewData["id"] as string ?? "tbl";
    var hint = ViewData["hint"] as string ?? "";
}
<section class="card dtable" id="@id" data-pagesize="@Model.PageSize">
    @if (!string.IsNullOrEmpty(Model.Heading))
    {
        <div class="card-title">@Model.Heading</div>
    }

    @if (Model.Toolbar || Model.AddLabel != null)
    {
        <div class="toolbar">
            @if (Model.Toolbar)
            {
                <label class="search">
                    @Icons.Svg("search", 18)
                    <input type="search" placeholder="Tìm kiếm trong @hint..." autocomplete="off" />
                    <kbd>Ctrl K</kbd>
                </label>
                <button type="button" class="btn-outline js-adv" aria-expanded="false">@Icons.Svg("search", 18) Tìm kiếm nâng cao <span class="adv-count" hidden></span></button>
            }
            <span class="grow"></span>
            @if (Model.AddLabel != null)
            {
                <button type="button" class="btn-primary" data-crud="create" data-entity="@Model.Entity">@Icons.Svg("plus", 18) @Model.AddLabel</button>
            }
        </div>
        @if (Model.Toolbar)
        {
            <div class="adv-panel" hidden></div>
        }
    }

    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    @foreach (var c in Model.Columns) { <th>@c</th> }
                    @if (Model.ShowActions) { <th class="col-act">Thao tác</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr data-peek="@r.Url">
                        @foreach (var cell in r.Cells) { <td>@Fmt.Cell(cell)</td> }
                        @if (Model.ShowActions)
                        {
                            <td class="col-act">
                                <div class="actions">
                                    @if (Model.CanEdit)
                                    {
                                        <button type="button" class="act" data-crud="edit" data-entity="@Model.Entity" data-id="@r.Id" title="Chỉnh sửa">@Icons.Svg("pencil", 18)</button>
                                    }
                                    @if (Model.LockAction != null && r.Locked is bool isLocked)
                                    {
                                        <button type="button" class="act @(isLocked ? "unlock" : "")" data-act="@Model.LockAction" data-id="@r.Id" data-confirm="@(isLocked ? $"Mở khóa tài khoản \"{r.Cells[0]}\"?" : $"Khóa tài khoản \"{r.Cells[0]}\"? Tài khoản sẽ không đăng nhập được, dữ liệu vẫn được giữ lại.")" title="@(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")">@Icons.Svg(isLocked ? "lock-open" : "lock", 18)</button>
                                    }
                                    @if (Model.RestoreAction != null)
                                    {
                                        <button type="button" class="act unlock" data-act="@Model.RestoreAction" data-id="@r.Id" data-confirm="@($"{Model.RestoreLabel} \"{r.Cells[0]}\"?")" title="@Model.RestoreLabel">@Icons.Svg("rotate-ccw", 18)</button>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button" class="act" data-crud="delete" data-entity="@Model.Entity" data-id="@r.Id" data-name="@r.Cells[0]" data-warn="@(Model.Entity == "category" ? "Các sản phẩm trong loại này cũng sẽ bị xóa khỏi cửa hàng. Sản phẩm đã có lịch sử mua thì được ẩn nhưng lịch sử mua hàng của khách vẫn giữ nguyên." : null)" title="Xóa">@Icons.Svg("trash", 18)</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Rows.Count == 0)
        {
            <div class="empty">Chưa có dữ liệu</div>
        }
    </div>

    @if (Model.Toolbar)
    {
        <div class="pager-bar">
            <span class="count"></span>
            <div class="pager"></div>
        </div>
    }
</section>
