@* Màn hình đăng nhập quản trị (giao diện mẫu: chưa kiểm tra tài khoản thật). *@
@{
    ViewData["Title"] = "Đăng nhập";
}
<form class="login" method="post" asp-controller="Account" asp-action="Login">
    <div class="login-brand">
        <span class="brand-mark">@Icons.Svg("activity", 24)</span>
        <span class="brand-name">SPORT<b>SHOP</b></span>
    </div>
    <h1>Đăng nhập quản trị</h1>
    <p class="login-sub">Hệ thống quản lý khách hàng (CRM)</p>
    <label for="username">Tên đăng nhập</label>
    <input id="username" name="username" type="text" value="quanly.minh" autocomplete="username" />
    <label for="password">Mật khẩu</label>
    <input id="password" name="password" type="password" value="123456" autocomplete="current-password" />
    <button class="btn-primary" type="submit">Đăng nhập</button>
    <div class="login-hint">Giao diện mẫu: chưa kiểm tra tài khoản thật.</div>
</form>
