@model ProductDetailVm
@{
    var M = Model.Product;
    ViewData["Title"] = M.Name;
    var vs = Model.Variants;
    var sold = Model.Sold;
    string price = vs.Count == 0 ? "Chưa có giá" : vs.Min(v => v.Price) == vs.Max(v => v.Price) ? Fmt.Money(vs[0].Price) : $"{Fmt.Money(vs.Min(v => v.Price))} - {Fmt.Money(vs.Max(v => v.Price))}";
}
<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16) Danh sách sản phẩm</a>
<div class="page-head">
    <div>
        <div class="eyebrow">SẢN PHẨM SP@(M.Id.ToString("D3"))</div>
        <h1 class="page-title">@M.Name</h1>
        <p class="page-sub">@Fmt.Cell(M.Visible ? "[g]Đang bán" : "[x]Đang ẩn")</p>
    </div>
    <div class="head-actions">
        <button type="button" class="btn-outline" data-crud="edit" data-entity="product" data-id="@M.Id">@Icons.Svg("pencil", 18) Chỉnh sửa</button>
    </div>
</div>

<div class="grid2">
    <section class="card pad">
        <h3 class="card-h">Thông tin sản phẩm</h3>
        @if (!string.IsNullOrEmpty(M.Image)) { <img class="detail-img" src="@M.Image" alt="@M.Name" loading="lazy" onerror="this.remove()" /> }
        <dl class="kv">
            <dt>Loại</dt><dd>@M.Category</dd>
            <dt>Đơn vị tính</dt><dd>@M.Unit</dd>
            <dt>Giá bán</dt><dd>@price</dd>
            <dt>Mô tả</dt><dd>@(string.IsNullOrEmpty(M.Description) ? "-" : M.Description)</dd>
        </dl>
    </section>
    <section class="card pad">
        <h3 class="card-h">Tồn kho &amp; bán hàng</h3>
        <dl class="kv">
            <dt>Số biến thể</dt><dd>@vs.Count</dd>
            <dt>Tổng tồn kho</dt><dd>@vs.Sum(v => v.Stock) @M.Unit</dd>
            <dt>Đã bán</dt><dd>@sold.Sum(l => l.Qty) @M.Unit</dd>
            <dt>Doanh thu</dt><dd>@Fmt.Money(sold.Sum(l => l.Amount))</dd>
        </dl>
    </section>
</div>

<section class="card">
    <div class="card-title">Biến thể sản phẩm</div>
    @if (vs.Count == 0)
    {
        <div class="empty">Sản phẩm chưa có biến thể</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="tbl">
                <thead><tr><th>Mã BT</th><th>Size</th><th>Màu</th><th class="r">Giá bán</th><th class="r">Giá vốn</th><th class="r">Tồn</th></tr></thead>
                <tbody>
                    @foreach (var v in vs)
                    {
                        <tr><td>BT@(v.Id.ToString("D3"))</td><td>@(v.Size ?? "-")</td><td>@(v.Color ?? "-")</td><td class="r">@Fmt.Money(v.Price)</td><td class="r">@Fmt.Money(v.Cost)</td><td class="r">@v.Stock</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
