@*
    Báo cáo thống kê: lọc theo khoảng thời gian (form GET: from, to) rồi hiển thị
      - 4 thẻ số liệu (doanh thu thuần, đơn hàng, giá trị trung bình, lợi nhuận)
      - biểu đồ vùng doanh thu theo tuần, biểu đồ cột sản phẩm bán chạy
      - biểu đồ tròn nhóm khách hàng theo tuổi, hiệu suất nhân viên
      - bảng lợi nhuận theo sản phẩm, tồn kho nhiều, hiệu quả khuyến mãi (theo PDF mục 3.1.9)
    Toạ độ biểu đồ đã được ReportsController tính sẵn.
*@
@using SportShop.Admin.Controllers
@model ReportsVm
@{
    ViewData["Title"] = "Báo cáo thống kê";
    const double circ = 2 * Math.PI * 54;     // chu vi vòng tròn bán kính 54 (biểu đồ tròn)
    double offset = 0;                        // vị trí bắt đầu của từng phần
    // Số thực → chuỗi dùng dấu chấm thập phân (bắt buộc cho thuộc tính SVG)
    string Num(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <div>
        <div class="eyebrow">SPORTSHOP ADMIN</div>
        <h1 class="page-title">Báo cáo thống kê</h1>
        <p class="page-sub">Phân tích hiệu quả kinh doanh</p>
    </div>
    <button type="button" class="btn-outline js-soon">@Icons.Svg("download", 18) Xuất báo cáo</button>
</div>

@* ===== Bộ lọc khoảng thời gian ===== *@
<form class="card range" method="get" asp-controller="Reports" asp-action="Index" id="rangeForm">
    <div class="range-input">
        @Icons.Svg("calendar", 20)
        <input type="date" name="from" id="fromDate" value="@Model.From.ToString("yyyy-MM-dd")" aria-label="Từ ngày" />
        <span>–</span>
        <input type="date" name="to" id="toDate" value="@Model.To.ToString("yyyy-MM-dd")" aria-label="Đến ngày" />
    </div>
    <div class="select-wrap plain">
        <select id="period" aria-label="Chọn nhanh kỳ báo cáo">
            <option value="">Tùy chọn</option>
            <option value="today">Hôm nay</option>
            <option value="7">7 ngày qua</option>
            <option value="30">30 ngày qua</option>
            <option value="month">Tháng này</option>
            <option value="quarter">Quý này</option>
            <option value="year">Năm nay</option>
        </select>
    </div>
    <button type="submit" class="btn-primary">Xem báo cáo</button>
</form>

@* ===== 4 thẻ số liệu ===== *@
<div class="kpis">
    <div class="kpi">
        <small>Doanh thu thuần</small>
        <div class="kpi-num">@Fmt.Compact(Model.Revenue)</div>
        <div class="kpi-sub @(Model.RevenueDelta.Up ? "up" : "down")">@Model.RevenueDelta.Text</div>
    </div>
    <div class="kpi">
        <small>Đơn hàng</small>
        <div class="kpi-num">@Model.Orders.ToString("N0")</div>
        <div class="kpi-sub @(Model.OrdersDelta.Up ? "up" : "down")">@Model.OrdersDelta.Text</div>
    </div>
    <div class="kpi">
        <small>Giá trị trung bình</small>
        <div class="kpi-num">@Fmt.Money(Model.Average)</div>
        <div class="kpi-sub @(Model.AverageDelta.Up ? "up" : "down")">@Model.AverageDelta.Text</div>
    </div>
    <div class="kpi">
        <small>Lợi nhuận</small>
        <div class="kpi-num">@Fmt.Compact(Model.Profit)</div>
        <div class="kpi-sub muted">Doanh thu trừ giá vốn</div>
    </div>
</div>

<div class="charts">
    @* ===== Biểu đồ vùng: doanh thu theo tuần ===== *@
    <section class="card pad chart-main">
        <div class="chart-head">
            <div><h3>Doanh thu theo tuần</h3><p>Đơn vị: triệu đồng</p></div>
            <span class="pill @(Model.RevenueDelta.Up ? "p-g" : "p-r")"><i></i>@Model.RevenueDelta.Text.Split(' ')[0]</span>
        </div>
        <svg class="area" viewBox="0 0 760 240" role="img" aria-label="Biểu đồ doanh thu theo tuần">
            <defs>
                <linearGradient id="areaFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0f766e" stop-opacity=".28" />
                    <stop offset="100%" stop-color="#0f766e" stop-opacity="0" />
                </linearGradient>
            </defs>
            @* Đường kẻ ngang + nhãn trục tung *@
            @foreach (var t in Model.YTicks)
            {
                <line x1="44" x2="744" y1="@Num(t.Y)" y2="@Num(t.Y)" class="grid-line" />
                @* Dùng Html.Raw vì Razor hiểu nhầm thẻ SVG <text> là thẻ đặc biệt của Razor *@
                @Html.Raw($"<text x=\"36\" y=\"{Num(t.Y + 4)}\" text-anchor=\"end\" class=\"axis\">{t.Label}</text>")
            }
            <path d="@Model.AreaPath" fill="url(#areaFill)" />
            <path d="@Model.LinePath" class="area-line" />
            @foreach (var d in Model.Dots)
            {
                <circle cx="@d.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" cy="@d.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" r="4" class="area-dot"><title>@d.Tip</title></circle>
            }
            @foreach (var l in Model.XLabels)
            {
                @Html.Raw($"<text x=\"{Num(l.X)}\" y=\"232\" text-anchor=\"middle\" class=\"axis\">{l.Label}</text>")
            }
        </svg>
    </section>

    @* ===== Biểu đồ cột: sản phẩm bán chạy ===== *@
    <section class="card pad chart-side">
        <div class="chart-head">
            <div><h3>Sản phẩm bán chạy</h3><p>Theo số lượng đã bán</p></div>
            <button type="button" class="dots js-soon" aria-label="Tùy chọn">@Icons.Svg("more", 18)</button>
        </div>
        @if (Model.Bars.Count == 0)
        {
            <div class="empty">Chưa có dữ liệu trong kỳ này</div>
        }
        else
        {
            <div class="bars">
                @foreach (var b in Model.Bars)
                {
                    <div class="bar-col" title="@b.Label: @b.Qty">
                        <span class="bar-val">@b.Qty</span>
                        <div class="bar @(b.Highlight ? "hot" : "")" style="height:@(b.Percent)%"></div>
                        <span class="bar-lbl">@b.Label</span>
                    </div>
                }
            </div>
        }
    </section>
</div>

<div class="charts two">
    @* ===== Biểu đồ tròn: nhóm khách hàng ===== *@
    <section class="card pad">
        <div class="donut-wrap">
            <div class="donut">
                <svg viewBox="0 0 140 140" aria-label="Nhóm khách hàng theo độ tuổi">
                    <circle cx="70" cy="70" r="54" fill="none" stroke="#eef2f4" stroke-width="22" />
                    @foreach (var p in Model.Donut)
                    {
                        double len = circ * (double)p.Percent / 100;
                        <circle cx="70" cy="70" r="54" fill="none" stroke="@p.Color" stroke-width="22"
                                stroke-dasharray="@len.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) @((circ - len).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                stroke-dashoffset="@((-offset).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                transform="rotate(-90 70 70)"><title>@p.Label: @p.Count khách</title></circle>
                        @* cộng dồn để phần kế tiếp bắt đầu đúng chỗ phần trước kết thúc *@
                        offset += len;

                    }
                </svg>
                <div class="donut-center"><b>@Model.CustomerTotal.ToString("N0")</b><small>khách hàng</small></div>
            </div>
            <div class="legend">
                <h3>Nhóm khách hàng</h3>
                @foreach (var p in Model.Donut)
                {
                    <div class="legend-row"><i style="background:@p.Color"></i><span>@p.Label</span><b>@p.Percent%</b></div>
                }
            </div>
        </div>
    </section>

    @* ===== Hiệu suất nhân viên ===== *@
    <section class="card pad">
        <div class="chart-head"><div><h3>Hiệu suất nhân viên</h3><p>Top nhân viên (hóa đơn + chăm sóc + phản hồi)</p></div></div>
        <div class="staff">
            @{ int rank = 0; }
            @foreach (var s in Model.Staff)
            {
                rank++;
                <div class="staff-row">
                    <span class="rank">@rank</span>
                    <span class="avatar sm">@s.Initials</span>
                    <div class="staff-main">
                        <b>@s.Name</b>
                        <small>@s.Detail</small>
                        <div class="meter"><i style="width:@(s.Score)%"></i></div>
                    </div>
                    <span class="score">@Icons.Svg("star", 16)<b>@s.Score%</b></span>
                </div>
            }
        </div>
    </section>
</div>

@* ===== Các bảng báo cáo chi tiết theo PDF ===== *@
<section class="card">
    <div class="card-title">Lợi nhuận theo sản phẩm</div>
    <div class="table-wrap">
        <table class="tbl">
            <thead><tr><th>Sản phẩm</th><th>Đã bán</th><th>Doanh thu (giá bán)</th><th>Giá vốn</th><th>Lợi nhuận</th></tr></thead>
            <tbody>@foreach (var r in Model.ProfitByProduct) { <tr><td>@r.Cells[0]</td><td>@r.Cells[1]</td><td>@r.Cells[2]</td><td>@r.Cells[3]</td><td><b>@r.Cells[4]</b></td></tr> }</tbody>
        </table>
        @if (Model.ProfitByProduct.Count == 0) { <div class="empty">Chưa có dữ liệu trong kỳ này</div> }
    </div>
</section>

<div class="charts two">
    <section class="card">
        <div class="card-title">Sản phẩm tồn kho nhiều</div>
        <div class="table-wrap"><table class="tbl"><thead><tr><th>Biến thể sản phẩm</th><th>Tồn</th></tr></thead>
            <tbody>@foreach (var r in Model.HighStock) { <tr><td>@r.Cells[0]</td><td><b>@r.Cells[1]</b></td></tr> }</tbody></table></div>
    </section>
    <section class="card">
        <div class="card-title">Hiệu quả khuyến mãi</div>
        <div class="table-wrap"><table class="tbl"><thead><tr><th>Chương trình</th><th>Lượt dùng</th><th>Đã giảm</th><th>Doanh thu HĐ</th></tr></thead>
            <tbody>@foreach (var r in Model.Promos) { <tr><td>@r.Cells[0]</td><td>@r.Cells[1]</td><td>@r.Cells[2]</td><td>@r.Cells[3]</td></tr> }</tbody></table></div>
    </section>
</div>

@section Scripts {
    <script>
        // Chọn nhanh kỳ báo cáo → điền sẵn 2 ô ngày rồi gửi form
        document.getElementById('period').addEventListener('change', function () {
            var v = this.value; if (!v) return;
            var end = new Date(), start = new Date();
            if (v === '7') start.setDate(end.getDate() - 6);
            else if (v === '30') start.setDate(end.getDate() - 29);
            else if (v === 'month') start = new Date(end.getFullYear(), end.getMonth(), 1);
            else if (v === 'quarter') start = new Date(end.getFullYear(), Math.floor(end.getMonth() / 3) * 3, 1);
            else if (v === 'year') start = new Date(end.getFullYear(), 0, 1);
            function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
            document.getElementById('fromDate').value = iso(start);
            document.getElementById('toDate').value = iso(end);
            document.getElementById('rangeForm').submit();
        });
    </script>
}
