@model AccountDetailVm
@{
    var M = Model.Account;
    ViewData["Title"] = M.Username;
    var emp = Model.Employee;
    var cus = Model.Customer;
    string status = M.Status switch { "hoat_dong" => "[g]Đang hoạt động", "bi_khoa" => "[x]Đã khóa", _ => "[r]Đã xóa" };
}
<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16) Danh sách tài khoản</a>
<div class="page-head">
    <div>
        <div class="eyebrow">TÀI KHOẢN TK@(M.Id.ToString("D3"))</div>
        <h1 class="page-title">@M.Username</h1>
        <p class="page-sub">@Fmt.Cell(status)</p>
    </div>
    <div class="head-actions">
        <button type="button" class="btn-outline" data-crud="edit" data-entity="account" data-id="@M.Id">@Icons.Svg("pencil", 18) Chỉnh sửa</button>
    </div>
</div>

<div class="grid2">
    <section class="card pad">
        <h3 class="card-h">Thông tin tài khoản</h3>
        <dl class="kv">
            <dt>Tên đăng nhập</dt><dd>@M.Username</dd>
            <dt>Vai trò</dt><dd>@M.Role</dd>
            <dt>Email</dt><dd>@(string.IsNullOrEmpty(M.Email) ? "-" : M.Email)</dd>
            <dt>Số điện thoại</dt><dd>@(string.IsNullOrEmpty(M.Phone) ? "-" : M.Phone)</dd>
            <dt>Trạng thái</dt><dd>@Fmt.Cell(status)</dd>
        </dl>
    </section>
    <section class="card pad">
        <h3 class="card-h">Hồ sơ gắn với tài khoản</h3>
        @if (emp != null)
        {
            <dl class="kv">
                <dt>Loại hồ sơ</dt><dd>Nhân viên</dd>
                <dt>Họ tên</dt><dd><a class="code" asp-controller="Employees" asp-action="Detail" asp-route-id="@emp.Id">@emp.LastName @emp.FirstName</a></dd>
                <dt>Mã nhân viên</dt><dd>NV@(emp.Id.ToString("D3"))</dd>
                <dt>Chức vụ</dt><dd>@emp.Position</dd>
                <dt>Tình trạng</dt><dd>@Fmt.Cell(emp.Working ? "[g]Đang làm việc" : "[x]Nghỉ việc")</dd>
            </dl>
        }
        else if (cus != null)
        {
            <dl class="kv">
                <dt>Loại hồ sơ</dt><dd>Khách hàng</dd>
                <dt>Họ tên</dt><dd><a class="code" asp-controller="Customers" asp-action="Detail" asp-route-id="@cus.Id">@cus.FullName</a></dd>
                <dt>Hạng</dt><dd>@cus.Tier</dd>
                <dt>Điểm tích lũy</dt><dd>@cus.Points.ToString("N0")</dd>
                <dt>Tổng chi tiêu</dt><dd>@Fmt.Money(cus.TotalSpent)</dd>
            </dl>
        }
        else
        {
            <div class="empty">Tài khoản chưa gắn với hồ sơ nhân viên hoặc khách hàng</div>
        }
    </section>
</div>
