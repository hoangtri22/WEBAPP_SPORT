@{
    bool loggedIn = !string.IsNullOrEmpty(Context.Session.GetString("customer"));
    string adminUrl = ViewData["AdminUrl"] as string ?? "#";
    int cartCount = ViewData["CartCount"] as int? ?? 0;
    string controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool onHome = controllerName == "Home" && actionName == "Index";
    bool onPromo = controllerName == "Shop" && actionName == "Promotions";
    bool onShop = controllerName == "Shop" && !onPromo;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "SPORTSHOP") - SPORTSHOP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-store.css" asp-append-version="true" />
</head>
<body class="storefront" data-db="@(ViewData["DbConnected"] is true ? "true" : "false")">
    @if (loggedIn)
    {
        <partial name="_SiteHeader" />
    }
    else
    {
        <div class="shop-promo">
            <span>FREESHIP toàn quốc cho đơn từ 500.000₫</span>
            <a asp-controller="Customer" asp-action="Orders">Theo dõi đơn hàng</a>
            <a href="@adminUrl">Trang quản trị</a>
        </div>

        <header class="shop-header">
            <a class="logo" asp-controller="Home" asp-action="Index"><span class="logo-mark">@Icons.Svg("activity", 21)</span><span class="logo-text">SPORT<b>SHOP</b></span></a>
            <nav>
                <a class="@(onHome ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="@(onShop ? "active" : "")" asp-controller="Shop" asp-action="Index">Sản phẩm</a>
                <a class="@(onPromo ? "active" : "")" asp-controller="Shop" asp-action="Promotions">Khuyến mãi</a>
            </nav>
            <div class="shop-actions">
                <button type="button" id="searchToggle" aria-label="Tìm kiếm">@Icons.Svg("search", 20)</button>
                <button type="button" class="hide-sm" data-needs-db aria-label="Yêu thích">@Icons.Svg("heart", 20)</button>
                <a class="hide-sm cart-button" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">@Icons.Svg("shopping-bag", 20)@if (cartCount > 0) {<i class="cart-count">@cartCount</i>}</a>
                <div class="shop-auth-actions">
                    <a class="link-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Đăng ký</a>
                </div>
            </div>
        </header>
    }

    <div class="shop-search" id="shopSearch" hidden>
        @Icons.Svg("search", 20)
        <input id="shopSearchInput" placeholder="Bạn đang tìm sản phẩm nào?" autocomplete="off" />
        <kbd>ESC</kbd>
    </div>

    <main class="shop-main">
        @RenderBody()
    </main>

    @if (loggedIn)
    {
        <partial name="_SiteFooter" />
    }
    else
    {
        <footer class="shop-footer">
            <div>
                <a class="logo" asp-controller="Home" asp-action="Index"><span class="logo-mark">@Icons.Svg("activity", 21)</span><span class="logo-text">SPORT<b>SHOP</b></span></a>
                <p>Đồng hành cùng bạn trên hành trình sống khỏe và chinh phục mọi giới hạn.</p>
                <span>@Icons.Svg("map-pin", 15) 128 Nguyễn Trãi, Quận 1, TP.HCM</span>
            </div>
            <div>
                <strong>Mua sắm</strong>
                <a asp-controller="Shop" asp-action="Index" asp-route-q="Giày">Giày thể thao</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-q="Quần áo">Quần áo</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-q="Phụ kiện">Dụng cụ</a>
                <a asp-controller="Shop" asp-action="Promotions">Khuyến mãi</a>
            </div>
            <div>
                <strong>Hỗ trợ</strong>
                <a asp-controller="Info" asp-action="Page" asp-route-id="doi-tra">Chính sách đổi trả</a>
                <a asp-controller="Info" asp-action="Page" asp-route-id="giao-hang">Giao hàng</a>
                <a asp-controller="Info" asp-action="Page" asp-route-id="chon-size">Hướng dẫn chọn size</a>
                <a asp-controller="Info" asp-action="Page" asp-route-id="lien-he">Liên hệ</a>
            </div>
            <div>
                <strong>SPORTSHOP</strong>
                <a asp-controller="Info" asp-action="Page" asp-route-id="ve-chung-toi">Về chúng tôi</a>
                <a asp-controller="Info" asp-action="Page" asp-route-id="he-thong-cua-hang">Hệ thống cửa hàng</a>
                <a asp-controller="Info" asp-action="Page" asp-route-id="tuyen-dung">Tuyển dụng</a>
                <a href="@adminUrl">Đăng nhập quản trị</a>
            </div>
        </footer>

        <nav class="shop-mobile-nav">
            <a class="@(onHome ? "active" : "")" asp-controller="Home" asp-action="Index">@Icons.Svg("store", 20)<span>Trang chủ</span></a>
            <button type="button" id="searchToggleMobile">@Icons.Svg("search", 20)<span>Tìm kiếm</span></button>
            <button type="button" data-needs-db>@Icons.Svg("heart", 20)<span>Yêu thích</span></button>
            <a asp-controller="Cart" asp-action="Index">@Icons.Svg("shopping-bag", 20)<span>Giỏ hàng@(cartCount > 0 ? " (" + cartCount + ")" : "")</span></a>
            <a asp-controller="Account" asp-action="Login">@Icons.Svg("user", 20)<span>Tài khoản</span></a>
        </nav>
    }

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src="~/js/shop.js" asp-append-version="true"></script>
    @if (TempData["ShopNotice"] is string shopNotice) { <script>showToast(@Json.Serialize(shopNotice));</script> }
    @if (TempData["ShopError"] is string shopError) { <script>showToast(@Json.Serialize(shopError));</script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
