@*
    Bán hàng tại quầy: bên trái là danh sách sản phẩm (tìm kiếm + lọc theo loại),
    bên phải là "Hóa đơn tạm". Bấm vào sản phẩm để thêm; nút +/- đổi số lượng.
    Phần tính tiền chạy bằng JavaScript trong wwwroot/js/admin.js (khối "POS").
*@
@{
    ViewData["Title"] = "Bán hàng tại quầy";
    // Màu nền cho ô chữ cái đại diện sản phẩm (theo loại)
    string Tone(string cat) => cat switch { "Giày" => "t-teal", "Quần áo" => "t-orange", "Vợt cầu lông" => "t-purple", _ => "t-blue" };
    var items = SampleData.Variants.Where(v => v.Stock > 0 && SampleData.Product(v.ProductId).Visible).ToList();
}
<div class="page-head">
    <div>
        <div class="eyebrow">SPORTSHOP ADMIN</div>
        <h1 class="page-title">Bán hàng tại quầy</h1>
        <p class="page-sub">Tạo hóa đơn nhanh cho khách tại cửa hàng</p>
    </div>
    <div class="chip">@Icons.Svg("store", 20) Quầy 01</div>
</div>

<div class="pos">
    @* ----- Bên trái: sản phẩm ----- *@
    <section class="card">
        <div class="toolbar">
            <label class="search">
                @Icons.Svg("search", 18)
                <input type="search" id="posSearch" placeholder="Quét mã hoặc tìm sản phẩm..." autocomplete="off" />
                <kbd>Ctrl K</kbd>
            </label>
        </div>
        <div class="chips" id="posChips">
            <button type="button" class="chip-btn active" data-cat="">Tất cả</button>
            @foreach (var cat in SampleData.Categories)
            {
                <button type="button" class="chip-btn" data-cat="@cat">@cat</button>
            }
        </div>
        <div class="pgrid" id="posGrid">
            @foreach (var v in items)
            {
                var p = SampleData.Product(v.ProductId);
                var variant = string.Join(" · ", new[] { v.Size == null ? null : "Size " + v.Size, v.Color }.Where(s => !string.IsNullOrEmpty(s)));
                <button type="button" class="pitem" data-id="@v.Id" data-name="@p.Name" data-variant="@variant"
                        data-price="@((long)v.Price)" data-stock="@v.Stock" data-cat="@p.Category" data-tone="@Tone(p.Category)">
                    <span class="tile @Tone(p.Category)">@p.Name.Substring(0, 1)</span>
                    <span class="pn">@p.Name</span>
                    <span class="pv">@variant</span>
                    <span class="pp">@Fmt.Money(v.Price)</span>
                    <span class="ps">Còn @v.Stock</span>
                </button>
            }
        </div>
    </section>

    @* ----- Bên phải: hóa đơn tạm ----- *@
    <aside class="card bill">
        <div class="bill-head">
            <div><h3>Hóa đơn tạm</h3><p id="billCount">0 sản phẩm</p></div>
            <button type="button" class="act danger" id="billClear" title="Xóa hóa đơn tạm">@Icons.Svg("trash", 18)</button>
        </div>
        <div class="bill-cust">
            <span class="mini-av">@Icons.Svg("user", 18)</span>
            <div>
                <small>Khách hàng</small>
                <select>
                    <option>Khách lẻ</option>
                    @foreach (var c in SampleData.Customers.Where(c => !c.Locked)) { <option>@c.FullName - @c.Phone</option> }
                </select>
            </div>
        </div>
        <ul id="billList" class="bill-list"></ul>
        <div class="bill-form">
            <label>Khuyến mãi
                <select id="billDiscount">
                    <option value="0">Không áp dụng</option>
                    <option value="15">SPORTNEW - giảm 15%</option>
                    <option value="10">VIP10 - giảm 10% (hạng VIP)</option>
                </select>
            </label>
            <label>Phương thức thanh toán
                <select><option>Tiền mặt</option><option>Chuyển khoản</option><option>Ví điện tử</option><option>Thẻ</option></select>
            </label>
        </div>
        <div class="sum">
            <div><span>Tiền hàng</span><span id="billSub">0đ</span></div>
            <div><span>Giảm giá</span><span id="billDisc">-0đ</span></div>
            <div class="total"><span>Tổng thanh toán</span><span id="billTotal">0đ</span></div>
        </div>
        <button type="button" class="btn-primary block js-soon">Thanh toán &amp; xuất hóa đơn</button>
    </aside>
</div>
