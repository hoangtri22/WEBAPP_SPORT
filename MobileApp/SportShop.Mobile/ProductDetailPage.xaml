<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.ProductDetailPage" x:DataType="vm:ProductDetailViewModel"
             Title="Chi tiết sản phẩm" BackgroundColor="#F5F7FA">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Giỏ hàng" Clicked="OnCartClicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0F766E" />
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF0E8" Stroke="#F1C8B2"
                        StrokeShape="RoundRectangle 12" Padding="14" AutomationId="ProductDetailError">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ErrorMessage}" TextColor="#8B3D1A" />
                        <Button Text="Tải lại sản phẩm" Clicked="OnRetryClicked" IsEnabled="{Binding IsIdle}"
                                BackgroundColor="#102C46" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout IsVisible="{Binding HasProduct}" Spacing="16">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="White">
                        <Grid HeightRequest="270">
                            <Label Text="SPORTSHOP" TextColor="#8B9AA9" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="14" SemanticProperties.Description="{Binding Name}" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding CategoryName}" TextColor="#607487" FontSize="12" />
                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="23" TextColor="#102C46" />
                    <Label Text="{Binding PriceText}" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#B64D1B" AutomationId="VariantPrice" />
                    <Border BackgroundColor="White" Stroke="#E3E9EF" StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Chọn size / màu" FontFamily="OpenSansSemibold" TextColor="#102C46" />
                            <Picker Title="Size và màu sắc" ItemsSource="{Binding Variants}" ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedVariant}" IsEnabled="{Binding IsIdle}" AutomationId="ProductVariant" />
                            <Label Text="{Binding StockText}" TextColor="#607487" FontSize="12" AutomationId="VariantStock" />
                            <Button Text="Hướng dẫn chọn size" Clicked="OnSizeGuideClicked" BackgroundColor="Transparent"
                                    TextColor="#0F766E" HorizontalOptions="Start" Padding="0" />
                            <Grid ColumnDefinitions="*,Auto,70,Auto" ColumnSpacing="6">
                                <Label Text="Số lượng" TextColor="#102C46" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="−" Clicked="OnDecreaseClicked" IsEnabled="{Binding CanDecrease}"
                                        WidthRequest="42" BackgroundColor="#E6EEF2" TextColor="#102C46" />
                                <Entry Grid.Column="2" Text="{Binding QuantityText}" Keyboard="Numeric" MaxLength="3"
                                       HorizontalTextAlignment="Center" IsEnabled="{Binding CanBuy}" AutomationId="ProductQuantity" />
                                <Button Grid.Column="3" Text="+" Clicked="OnIncreaseClicked" IsEnabled="{Binding CanIncrease}"
                                        WidthRequest="42" BackgroundColor="#E6EEF2" TextColor="#102C46" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="#237044" AutomationId="ProductAdded" />
                    <Button Text="Xem / gửi đánh giá sản phẩm" Clicked="OnReviewsClicked" BackgroundColor="White"
                            TextColor="#0F766E" BorderColor="#0F766E" BorderWidth="1" CornerRadius="12" AutomationId="ProductReviews" />
                    <Label Text="Thông tin sản phẩm" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#102C46" />
                    <Label Text="{Binding Description}" TextColor="#40566B" FontSize="14" LineHeight="1.25" />
                    <Label Text="Giá và tồn kho được xác nhận lại khi thêm giỏ và thanh toán." TextColor="#607487" FontSize="11" />
                    <VerticalStackLayout Spacing="10" AutomationId="RelatedProductsSection">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Sản phẩm cùng loại" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#102C46" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsRelatedLoading}"
                                               IsVisible="{Binding IsRelatedLoading}" Color="#0F766E" HeightRequest="24" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding HasRelatedError}" Spacing="6">
                            <Label Text="{Binding RelatedErrorMessage}" TextColor="#8B3D1A" FontSize="12" />
                            <Button Text="Tải lại sản phẩm cùng loại" Clicked="OnRetryRelatedClicked"
                                    IsEnabled="{Binding CanRetryRelated}" BackgroundColor="#102C46" TextColor="White"
                                    HorizontalOptions="Start" AutomationId="RetryRelatedProducts" />
                        </VerticalStackLayout>
                        <Label Text="Chưa có sản phẩm cùng loại còn hàng." IsVisible="{Binding ShowRelatedEmpty}"
                               TextColor="#607487" FontSize="13" AutomationId="RelatedProductsEmpty" />
                        <CollectionView ItemsSource="{Binding RelatedProducts}" SelectionMode="None" HeightRequest="286"
                                        IsVisible="{Binding HasRelatedProducts}" AutomationId="RelatedProductList">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductCard">
                                    <Border WidthRequest="164" BackgroundColor="White" Stroke="#E3E9EF" StrokeShape="RoundRectangle 16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRelatedProductTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid HeightRequest="142" BackgroundColor="#EDF1F5">
                                                <Label Text="SPORTSHOP" FontSize="12" TextColor="#8B9AA9"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="8"
                                                       SemanticProperties.Description="{Binding Name}" />
                                            </Grid>
                                            <VerticalStackLayout Padding="12" Spacing="6">
                                                <Label Text="{Binding CategoryName}" TextColor="#667D8F" FontSize="10"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Name}" TextColor="#102C46" FontFamily="OpenSansSemibold"
                                                       FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="42" />
                                                <Label Text="{Binding PriceText}" TextColor="#B64D1B" FontFamily="OpenSansSemibold" FontSize="15" />
                                                <Label Text="{Binding StockText}" TextColor="#237044" FontSize="10" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="16,10" BackgroundColor="White"
              IsVisible="{Binding HasProduct}">
            <Button Text="Thêm vào giỏ" Clicked="OnAddClicked" IsEnabled="{Binding CanBuy}"
                    BackgroundColor="#E5F3EF" TextColor="#0F766E" CornerRadius="12" AutomationId="AddProductToCart" />
            <Button Grid.Column="1" Text="Mua ngay" Clicked="OnBuyNowClicked" IsEnabled="{Binding CanBuy}"
                    BackgroundColor="#0F766E" TextColor="White" CornerRadius="12" AutomationId="BuyProductNow" />
        </Grid>
        <Grid x:Name="AddSuccessOverlay" Grid.RowSpan="2" ZIndex="10" IsVisible="False"
              BackgroundColor="#80000000" Padding="18" AutomationId="ProductAddedDialog">
            <ScrollView x:Name="SuccessDialogScroll">
                <Grid RowDefinitions="*,Auto,*"
                      MinimumHeightRequest="{Binding Height, Source={x:Reference SuccessDialogScroll}, x:DataType=ScrollView}">
                    <Border Grid.Row="1" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 22"
                            Padding="20" VerticalOptions="Center" HorizontalOptions="Fill" MaximumWidthRequest="440">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Bg}">
                                    <Image Source="{Binding ImageUrl}" HeightRequest="72" WidthRequest="72" Aspect="AspectFit"
                                           Margin="6" SemanticProperties.Description="{Binding Name}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                    <Label Text="ĐÃ THÊM VÀO GIỎ" TextColor="{StaticResource Teal}" FontSize="10"
                                           CharacterSpacing="1" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Name}" TextColor="{StaticResource Ink}" FontSize="14"
                                           FontFamily="OpenSansSemibold" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PriceText}" TextColor="{StaticResource Teal}" FontSize="13" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="×" Clicked="OnDismissAddedClicked" BackgroundColor="Transparent"
                                        TextColor="{StaticResource Muted}" FontSize="24" Padding="0" WidthRequest="44"
                                        HeightRequest="44" VerticalOptions="Start" SemanticProperties.Description="Đóng thông báo"
                                        AutomationId="DismissProductAdded" />
                            </Grid>
                            <Label Text="Đã thêm sản phẩm vào giỏ hàng thành công!" TextColor="{StaticResource Ink}"
                                   FontFamily="OpenSansSemibold" FontSize="19" SemanticProperties.HeadingLevel="Level1"
                                   AutomationId="ProductAddedSuccessMessage" />
                            <Button Text="Tiếp tục mua sắm" Clicked="OnContinueShoppingClicked"
                                    BackgroundColor="{StaticResource Teal}" TextColor="White" CornerRadius="12"
                                    MinimumHeightRequest="48" AutomationId="ContinueShoppingAfterAdd" />
                            <Button Text="Xem giỏ hàng" Clicked="OnCartClicked" BackgroundColor="White"
                                    TextColor="{StaticResource Teal}" BorderColor="{StaticResource Teal}" BorderWidth="1"
                                    CornerRadius="12" MinimumHeightRequest="48" AutomationId="ViewCartAfterAdd" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
