<?xml version="1.0" encoding="utf-8" ?>
<!-- Đơn hàng của tôi, tương ứng Views/Customer/Orders.cshtml của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.OrdersPage" x:DataType="vm:OrdersViewModel"
             NavigationPage.HasNavigationBar="False" Title="Đơn hàng">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout BackgroundColor="White" Padding="16,12,16,10" Spacing="10">
            <VerticalStackLayout Spacing="0">
                <Label Text="Đơn hàng của tôi" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Theo dõi trạng thái, cửa hàng cập nhật mỗi khi xử lý." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource FieldBox}" BackgroundColor="{StaticResource Bg}" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_search_muted.png" Style="{StaticResource FieldIcon}" />
                    <Entry Grid.Column="1" Text="{Binding SearchKeyword}" Placeholder="Mã đơn, sản phẩm, người nhận…" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusTabs}" Spacing="8" Padding="16,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderStatusTabItem">
                            <Border BackgroundColor="{Binding BgHex}" Stroke="{Binding BorderHex}" StrokeShape="RoundRectangle 18" Padding="14,0" MinimumHeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnStatusTabTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" TextColor="{Binding TextHex}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Refreshing="OnRefreshing" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView>
                <VerticalStackLayout Padding="16,14,16,28" Spacing="14">
                    <Border IsVisible="{Binding HasError}" Style="{StaticResource AlertError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                    </Border>
                    <Border IsVisible="{Binding HasStatus}" Style="{StaticResource AlertSuccess}">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource AlertSuccessText}" />
                    </Border>

                    <controls:EmptyState IsVisible="{Binding IsEmpty}" Icon="ic_package_teal.png" Title="Chưa có đơn hàng"
                                         Message="Đơn bạn đặt trên app hoặc web sẽ hiện ở đây." ActionText="Mua sắm ngay" ActionClicked="OnShopNowClicked" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderMasterCard">
                                <Border Style="{StaticResource Card}" Stroke="{Binding BorderColorHex}" Padding="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnOrderCardTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Code}" FontFamily="OpenSansSemibold" FontSize="15" />
                                                <Label Text="{Binding DateText}" Style="{StaticResource SmallMuted}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                                <Border BackgroundColor="{Binding StatusBgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,3" HorizontalOptions="End">
                                                    <Label Text="{Binding StatusLabel}" Style="{StaticResource PillText}" TextColor="{Binding StatusColorHex}" />
                                                </Border>
                                                <Border BackgroundColor="{Binding PaymentBadgeBgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,3" HorizontalOptions="End">
                                                    <Label Text="{Binding PaymentStatusLabel}" Style="{StaticResource PillText}" TextColor="{Binding PaymentBadgeTextHex}" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" />

                                        <Grid IsVisible="{Binding ShowProgress}" ColumnDefinitions="*,*,*,*" Padding="8,12,8,4">
                                            <VerticalStackLayout Spacing="4">
                                                <Border BackgroundColor="{Binding Step1BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 13" WidthRequest="26" HeightRequest="26">
                                                    <Label Text="{Binding Step1Icon}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding Step1TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="Chờ xác nhận" FontSize="10" TextColor="{Binding Step1LabelHex}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Border BackgroundColor="{Binding Step2BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 13" WidthRequest="26" HeightRequest="26">
                                                    <Label Text="{Binding Step2Icon}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding Step2TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="Đang chuẩn bị" FontSize="10" TextColor="{Binding Step2LabelHex}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                                <Border BackgroundColor="{Binding Step3BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 13" WidthRequest="26" HeightRequest="26">
                                                    <Label Text="{Binding Step3Icon}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding Step3TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="Đang giao" FontSize="10" TextColor="{Binding Step3LabelHex}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                                <Border BackgroundColor="{Binding Step4BgHex}" StrokeThickness="0" StrokeShape="RoundRectangle 13" WidthRequest="26" HeightRequest="26">
                                                    <Label Text="{Binding Step4Icon}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding Step4TextHex}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="Đã giao" FontSize="10" TextColor="{Binding Step4LabelHex}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border IsVisible="{Binding ShowCancelledAlert}" Style="{StaticResource AlertError}" Margin="14,12,14,0" Padding="12,8">
                                            <Label Text="{Binding CancelledAlertText}" Style="{StaticResource AlertErrorText}" FontSize="12" FontFamily="OpenSansSemibold" />
                                        </Border>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="10" Padding="14,12">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OrderSubLineItem">
                                                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="10">
                                                        <Border BackgroundColor="{StaticResource TealTint}" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="52" HeightRequest="52">
                                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="4" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding NameAndVariantText}" FontFamily="OpenSansSemibold" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding PriceTimesQtyText}" Style="{StaticResource SmallMuted}" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Border BackgroundColor="{StaticResource Bg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="14,0" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                                <Label Text="Giao đến" Style="{StaticResource SmallMuted}" />
                                                <Label Grid.Column="1" Text="{Binding ReceiverName}" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" />
                                                <Label Grid.Row="1" Text="Điện thoại" Style="{StaticResource SmallMuted}" />
                                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverPhone}" FontSize="12" HorizontalTextAlignment="End" />
                                                <Label Grid.Row="2" Text="Địa chỉ" Style="{StaticResource SmallMuted}" />
                                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReceiverAddress}" FontSize="12" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />
                                                <Label Grid.Row="3" Text="Thanh toán" Style="{StaticResource SmallMuted}" />
                                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding PaymentMethod}" FontSize="12" HorizontalTextAlignment="End" />
                                                <Label Grid.Row="4" Text="Giảm · Ship" Style="{StaticResource SmallMuted}" />
                                                <Label Grid.Row="4" Grid.Column="1" FontSize="12" HorizontalTextAlignment="End">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding DiscountText}" TextColor="{StaticResource Danger}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding ShippingFeeText}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Padding="14,8,14,0" Spacing="2">
                                            <Label IsVisible="{Binding HasShippingTracking}" Text="{Binding ShippingTrackingLineText}" FontSize="12" TextColor="{StaticResource Teal}" />
                                            <Label IsVisible="{Binding HasInvoice}" Text="{Binding InvoiceLineText}" Style="{StaticResource SmallMuted}" />
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*,Auto" Padding="14,10,14,14" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding ItemCountText}" Style="{StaticResource SmallMuted}" />
                                                <Label Text="{Binding TotalText}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Teal}" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                <Button IsVisible="{Binding CanCancel}" Text="Hủy đơn" CommandParameter="{Binding .}" Clicked="OnCancelOrderCardClicked"
                                                        Style="{StaticResource DangerButton}" HeightRequest="42" Padding="16,0" />
                                                <Button IsVisible="{Binding CanReview}" Text="Đánh giá" ImageSource="ic_star_orange.png" ContentLayout="Left,6"
                                                        CommandParameter="{Binding .}" Clicked="OnReviewOrderClicked" Style="{StaticResource SoftButton}" HeightRequest="42" Padding="14,0" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
