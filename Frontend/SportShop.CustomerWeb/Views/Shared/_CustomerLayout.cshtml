<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="~/js/tab-session.js" data-cookie="sportshop-shop-tab"></script>
    <title>@(ViewData["Title"] ?? "Tài khoản") - SPORTSHOP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-store.css" asp-append-version="true" />
</head>
<body class="customer-area" data-db="@(ViewData["DbConnected"] is true ? "true" : "false")">
    <partial name="_SiteHeader" />
    <partial name="_SearchBar" />
    <main class="customer-content">
        @RenderBody()
    </main>
    <partial name="_SiteFooter" />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src="~/js/shop.js" asp-append-version="true"></script>
    @if (TempData["Notice"] is string notice)
    {
        <script>showToast(@Json.Serialize(notice));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
