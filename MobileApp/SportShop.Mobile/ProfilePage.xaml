<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.ProfilePage" x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource Bg}" Title="Tài khoản">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Teal}" />

            <Border IsVisible="{Binding HasError}" BackgroundColor="#FDECEC" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" AutomationId="ProfileError" />
            </Border>
            <Border IsVisible="{Binding HasStatus}" BackgroundColor="{StaticResource TealSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Teal}" FontSize="13" AutomationId="ProfileStatus" />
            </Border>
            <Button Text="Thử lại" Command="{Binding LoadCommand}" IsVisible="{Binding CanRetry}" Style="{StaticResource OutlineButton}" AutomationId="ProfileRetry" />

            <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="14">
                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{StaticResource Teal}" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Label Text="{Binding Initials}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Username}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" AutomationId="ProfileUsername" />
                            <Label Text="{Binding SummaryText}" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Họ và tên" Style="{StaticResource SmallMuted}" Margin="4,0,0,-8" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_user_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding FullName}" Placeholder="Họ và tên" Style="{StaticResource FieldEntry}" MaxLength="101" AutomationId="ProfileFullName" />
                    </Grid>
                </Border>

                <Label Text="Email" Style="{StaticResource SmallMuted}" Margin="4,0,0,-8" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_mail_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Email" Style="{StaticResource FieldEntry}" Keyboard="Email" MaxLength="100" AutomationId="ProfileEmail" />
                    </Grid>
                </Border>

                <Label Text="Số điện thoại" Style="{StaticResource SmallMuted}" Margin="4,0,0,-8" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_phone_muted.png" Style="{StaticResource FieldIcon}" />
                        <Entry Grid.Column="1" Text="{Binding Phone}" Placeholder="Số điện thoại" Style="{StaticResource FieldEntry}" Keyboard="Telephone" MaxLength="10" AutomationId="ProfilePhone" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ngày sinh" Style="{StaticResource SmallMuted}" Margin="4,0,0,0" />
                        <Border Style="{StaticResource FieldBox}">
                            <DatePicker Date="{Binding Birth}" MaximumDate="{Binding Today}" Format="dd/MM/yyyy" TextColor="{StaticResource Ink}" AutomationId="ProfileBirth" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Giới tính" Style="{StaticResource SmallMuted}" Margin="4,0,0,0" />
                        <Border Style="{StaticResource FieldBox}">
                            <Picker ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" Title="Chọn" TextColor="{StaticResource Ink}" AutomationId="ProfileGender" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Lưu hồ sơ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" AutomationId="ProfileSave" />
                <Button Text="Đổi mật khẩu" Clicked="OnChangePasswordClicked" Style="{StaticResource OutlineButton}" AutomationId="ProfileChangePassword" />
            </VerticalStackLayout>

            <Button Text="Đăng xuất" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                    FontFamily="OpenSansSemibold" AutomationId="ProfileLogout" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
