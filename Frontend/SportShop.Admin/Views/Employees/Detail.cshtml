@model EmployeeDetailVm
@{
    var M = Model.Employee;
    string fullName = $"{M.LastName} {M.FirstName}";
    ViewData["Title"] = fullName;
    var orders = Model.Orders;
    int care = Model.Care;
    int replies = Model.Replies;
}
<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16) Danh sách nhân viên</a>
<div class="page-head">
    <div>
        <div class="eyebrow">NHÂN VIÊN NV@(M.Id.ToString("D3"))</div>
        <h1 class="page-title">@fullName</h1>
        <p class="page-sub">@Fmt.Cell(M.Working ? "[g]Đang làm việc" : "[x]Nghỉ việc")</p>
    </div>
    <div class="head-actions">
        <button type="button" class="btn-outline" data-crud="edit" data-entity="employee" data-id="@M.Id">@Icons.Svg("pencil", 18) Chỉnh sửa</button>
    </div>
</div>

<div class="grid2">
    <section class="card pad">
        <h3 class="card-h">Thông tin nhân viên</h3>
        <dl class="kv">
            <dt>Giới tính</dt><dd>@(string.IsNullOrEmpty(M.Gender) ? "-" : M.Gender)</dd>
            <dt>Ngày sinh</dt><dd>@(M.Birth.HasValue ? Fmt.Date(M.Birth.Value) : "-")</dd>
            <dt>Chức vụ</dt><dd>@M.Position</dd>
            <dt>Lương cơ bản</dt><dd>@Fmt.Money(M.BaseSalary)</dd>
        </dl>
        <h3 class="card-h" style="margin-top:18px">Tài khoản</h3>
        <dl class="kv">
            <dt>Tên đăng nhập</dt><dd>@M.Username</dd>
            <dt>Vai trò</dt><dd>@M.Role</dd>
            <dt>Email</dt><dd>@(string.IsNullOrEmpty(M.Email) ? "-" : M.Email)</dd>
            <dt>Số điện thoại</dt><dd>@(string.IsNullOrEmpty(M.Phone) ? "-" : M.Phone)</dd>
        </dl>
    </section>
    <section class="card pad">
        <h3 class="card-h">Hoạt động</h3>
        <dl class="kv">
            <dt>Đơn đã lập</dt><dd>@orders.Count</dd>
            <dt>Hóa đơn</dt><dd>@orders.Count(o => o.Invoiced)</dd>
            <dt>Doanh thu hóa đơn</dt><dd>@Fmt.Money(orders.Where(o => o.Invoiced).Sum(o => o.Total))</dd>
            <dt>Phiếu nhập</dt><dd>@Model.Imports</dd>
            <dt>Lần chăm sóc khách</dt><dd>@care</dd>
            <dt>Phản hồi đã trả lời</dt><dd>@replies</dd>
        </dl>
    </section>
</div>

<section class="card">
    <div class="card-title">Đơn hàng đã lập</div>
    @if (orders.Count == 0)
    {
        <div class="empty">Nhân viên chưa lập đơn hàng nào</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="tbl">
                <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th class="r">Tổng tiền</th><th>Trạng thái</th></tr></thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr><td><a class="code" asp-controller="Orders" asp-action="Detail" asp-route-id="@o.Code">@o.Code</a></td><td>@Model.CustomerNames[o.CustomerId]</td><td>@Fmt.DateTimeDot(o.Date)</td><td class="r">@Fmt.Money(o.Total)</td><td>@Fmt.Cell(Fmt.OrderStatus(o.Status))</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
