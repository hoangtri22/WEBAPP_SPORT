@* Thanh tìm kiếm nhanh ở đầu trang (shop.js: nút #searchToggle, Ctrl + K, ESC), gửi đến /Shop?q=...; dùng trong _Layout.cshtml và _CustomerLayout.cshtml. *@
@{
    var headerSearch = new SearchInputVm(null, "Bạn đang tìm sản phẩm nào?", "shopSearchInput");
}
<form class="shop-search" id="shopSearch" method="get" asp-controller="Shop" asp-action="Index" hidden>
    <partial name="_SearchInput" model="headerSearch" />
    <a class="shop-search-adv" asp-controller="Shop" asp-action="Index" asp-route-adv="1">Tìm kiếm nâng cao</a>
    <kbd>ESC</kbd>
</form>
