<?xml version="1.0" encoding="utf-8" ?>
<!-- Đăng nhập và đăng ký, tương ứng Views/Account/Auth.cshtml của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.AuthPage" x:DataType="vm:AuthViewModel"
             Title="SPORTSHOP">
    <Grid>
    <Border HeightRequest="340" VerticalOptions="Start" StrokeThickness="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Teal}" Offset="0" />
                <GradientStop Color="{StaticResource TealDark}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    <ScrollView>
        <VerticalStackLayout>
            <VerticalStackLayout Padding="24,40,24,30" Spacing="10">
                <controls:BrandLogo Light="True" HorizontalOptions="Start" />
                <Label Text="SỐNG KHỎE · CHƠI HẾT MÌNH" Margin="0,18,0,0" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.6" TextColor="#FDBA74" />
                <Label Text="Chào mừng bạn trở lại đường đua." FontFamily="OpenSansSemibold" FontSize="24" TextColor="White" IsVisible="{Binding IsLogin}" />
                <Label Text="Bắt đầu hành trình của riêng bạn." FontFamily="OpenSansSemibold" FontSize="24" TextColor="White" IsVisible="{Binding IsRegister}" />
                <Label Text="Đăng nhập để quản lý đơn hàng, dùng ưu đãi thành viên và chia sẻ trải nghiệm cùng SPORTSHOP." FontSize="13" TextColor="{StaticResource TealSoft}" />
            </VerticalStackLayout>
            <Border BackgroundColor="{StaticResource Bg}" StrokeThickness="0" StrokeShape="RoundRectangle 26,26,0,0" Padding="20,22,20,30">
                <VerticalStackLayout Spacing="14">
                    <Border BackgroundColor="{StaticResource Line}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Button Text="Đăng nhập" Command="{Binding ShowLoginCommand}" Style="{StaticResource TabButton}" AutomationId="LoginTab">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLogin}" Value="True">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="TextColor" Value="{StaticResource Teal}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="Đăng ký" Command="{Binding ShowRegisterCommand}" Style="{StaticResource TabButton}" AutomationId="RegisterTab">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsRegister}" Value="True">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="TextColor" Value="{StaticResource Teal}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FieldBox}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="ic_user_muted.png" Style="{StaticResource FieldIcon}" />
                            <Entry Grid.Column="1" Text="{Binding Username}" Placeholder="{Binding UsernameHint}" Style="{StaticResource FieldEntry}" Keyboard="Email" AutomationId="Username" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBox}" IsVisible="{Binding IsRegister}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="ic_mail_muted.png" Style="{StaticResource FieldIcon}" />
                            <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Email" Style="{StaticResource FieldEntry}" Keyboard="Email" MaxLength="100" AutomationId="Email" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FieldBox}" IsVisible="{Binding IsRegister}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="ic_phone_muted.png" Style="{StaticResource FieldIcon}" />
                            <Entry Grid.Column="1" Text="{Binding Phone}" Placeholder="Số điện thoại" Style="{StaticResource FieldEntry}" Keyboard="Telephone" MaxLength="10" AutomationId="Phone" />
                        </Grid>
                    </Border>
                    <Label IsVisible="{Binding IsRegister}" Text="Đã từng mua hàng bằng số này? Đơn hàng và địa chỉ sẽ tự đồng bộ vào tài khoản." Style="{StaticResource SmallMuted}" Margin="4,-6,4,0" />
                    <Border Style="{StaticResource FieldBox}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                            <Entry x:Name="PasswordEntry" Grid.Column="1" Text="{Binding Password}" Placeholder="Mật khẩu (tối thiểu 6 ký tự)" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128"
                                   ReturnType="Go" ReturnCommand="{Binding SubmitCommand}" AutomationId="Password" />
                            <ImageButton x:Name="PasswordToggle" Grid.Column="2" Source="ic_eye_muted.png" Clicked="OnTogglePasswordClicked" WidthRequest="40" HeightRequest="40" Padding="10"
                                         SemanticProperties.Description="Hiện hoặc ẩn mật khẩu" />
                        </Grid>
                    </Border>

                    <Button Text="Quên mật khẩu?" Clicked="OnForgotPasswordClicked" IsVisible="{Binding IsLogin}" BackgroundColor="Transparent" TextColor="{StaticResource Teal}"
                            FontSize="13" Padding="0" HeightRequest="32" HorizontalOptions="End" Margin="0,-6,0,-6" AutomationId="ForgotPassword" />

                    <Border IsVisible="{Binding HasError}" Style="{StaticResource AlertError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" AutomationId="AuthError" />
                    </Border>

                    <Grid>
                        <Button Text="{Binding SubmitText}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" AutomationId="Submit" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White"
                                           HeightRequest="24" WidthRequest="24" HorizontalOptions="End" Margin="0,0,16,0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,4">
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="hoặc" FontSize="12" TextColor="{StaticResource Muted}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Line}" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Tiếp tục với Google" Command="{Binding GoogleCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="50" AutomationId="GoogleLogin" />
                    <Button Text="Mua hàng không cần tài khoản" Command="{Binding GuestCommand}" Style="{StaticResource OutlineButton}" AutomationId="Guest" />
                    <Label Text="Không cần tài khoản. Tên thiết bị sẽ được gửi lên hệ thống của cửa hàng."
                           FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
