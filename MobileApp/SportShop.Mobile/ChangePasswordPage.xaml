<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.ChangePasswordPage" x:DataType="vm:ChangePasswordViewModel"
             BackgroundColor="{StaticResource Bg}" Title="Đổi mật khẩu">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Sau khi đổi mật khẩu, bạn cần đăng nhập lại trên mọi thiết bị." Style="{StaticResource SmallMuted}" />

            <Border Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                    <Entry Grid.Column="1" Text="{Binding CurrentPassword}" Placeholder="Mật khẩu hiện tại" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128" AutomationId="CurrentPassword" />
                </Grid>
            </Border>
            <Border Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                    <Entry Grid.Column="1" Text="{Binding NewPassword}" Placeholder="Mật khẩu mới" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128" AutomationId="NewPassword" />
                </Grid>
            </Border>
            <Border Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_lock_muted.png" Style="{StaticResource FieldIcon}" />
                    <Entry Grid.Column="1" Text="{Binding ConfirmPassword}" Placeholder="Nhập lại mật khẩu mới" Style="{StaticResource FieldEntry}" IsPassword="True" MaxLength="128"
                           ReturnType="Go" ReturnCommand="{Binding SubmitCommand}" AutomationId="ConfirmPassword" />
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasError}" BackgroundColor="#FDECEC" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" AutomationId="PasswordError" />
            </Border>

            <Button Text="Đổi mật khẩu" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" AutomationId="PasswordSubmit" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Teal}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
