<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.ReviewsPage" x:DataType="vm:ReviewsViewModel"
             Title="Đánh giá sản phẩm" BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="{Binding ProductName}" FontSize="23" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
            <Label Text="{Binding Summary}" FontSize="17" TextColor="{StaticResource Teal}" AutomationId="ReviewSummary" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" AutomationId="ReviewsError" />
            <Button Text="Tải lại đánh giá" Clicked="OnRefreshClicked" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />
            <Label Text="Chưa có đánh giá công khai. Hãy chia sẻ trải nghiệm sau khi nhận hàng." IsVisible="{Binding ShowEmpty}" Style="{StaticResource SmallMuted}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reviews}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewCard">
                        <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Author}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                    <Label Grid.Column="1" Text="{Binding Stars}" TextColor="{StaticResource Orange}" />
                                </Grid>
                                <Label Text="{Binding SentAt}" Style="{StaticResource SmallMuted}" />
                                <Label Text="{Binding Content}" TextColor="{StaticResource Ink}" />
                                <VerticalStackLayout IsVisible="{Binding HasReply}" BackgroundColor="{StaticResource TealSoft}" Padding="12" Spacing="5">
                                    <Label Text="SPORTSHOP trả lời" TextColor="{StaticResource Teal}" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Reply}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Xem thêm đánh giá" Clicked="OnMoreClicked" IsVisible="{Binding HasMore}" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />

            <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,10" />
            <Label Text="Đánh giá của bạn" FontSize="20" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
            <Label Text="{Binding EligibilityText}" Style="{StaticResource SmallMuted}" />
            <Button Text="Đăng nhập / Đăng ký" Clicked="OnLoginClicked" IsVisible="{Binding IsGuest}" Style="{StaticResource PrimaryButton}" />
            <Label Text="{Binding AccountError}" IsVisible="{Binding HasAccountError}" TextColor="{StaticResource Danger}" />
            <VerticalStackLayout IsVisible="{Binding IsEligible}" Spacing="10">
                <Label Text="Số sao" TextColor="{StaticResource Ink}" />
                <Picker ItemsSource="{Binding StarOptions}" SelectedItem="{Binding Stars}" Title="Chọn từ 1 đến 5 sao" IsEnabled="{Binding CanSend}" TextColor="{StaticResource Ink}" AutomationId="ReviewStars" />
                <Border Padding="10" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 10">
                    <Editor Text="{Binding Content}" Placeholder="Chia sẻ trải nghiệm sản phẩm (tối đa 1000 ký tự)" MaxLength="1000"
                            AutoSize="TextChanges" MinimumHeightRequest="120" IsEnabled="{Binding CanSend}" TextColor="{StaticResource Ink}" AutomationId="ReviewContent" />
                </Border>
                <Button Text="Gửi đánh giá" Clicked="OnSendClicked" IsEnabled="{Binding CanSend}" Style="{StaticResource PrimaryButton}" AutomationId="SendProductReview" />
            </VerticalStackLayout>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Teal}" AutomationId="ReviewSent" />
            <VerticalStackLayout IsVisible="{Binding IsSignedIn}" Spacing="12">
                <Label Text="Lịch sử đánh giá đã gửi" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                <Label Text="Bạn vẫn xem được đánh giá của mình khi cửa hàng ẩn nội dung khỏi danh sách công khai." Style="{StaticResource SmallMuted}" />
                <Label Text="Bạn chưa gửi đánh giá cho sản phẩm này." IsVisible="{Binding ShowMyEmpty}" Style="{StaticResource SmallMuted}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyReviews}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MyReviewCard">
                            <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="{Binding Stars}" TextColor="{StaticResource Orange}" />
                                    <Label Text="{Binding Status}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Teal}" />
                                    <Label Text="{Binding SentAt}" Style="{StaticResource SmallMuted}" />
                                    <Label Text="{Binding Content}" TextColor="{StaticResource Ink}" />
                                    <VerticalStackLayout IsVisible="{Binding HasReply}" BackgroundColor="{StaticResource TealSoft}" Padding="12" Spacing="5">
                                        <Label Text="SPORTSHOP trả lời" FontFamily="OpenSansSemibold" TextColor="{StaticResource Teal}" />
                                        <Label Text="{Binding Reply}" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Xem thêm lịch sử" Clicked="OnMoreMineClicked" IsVisible="{Binding HasMoreMine}" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
