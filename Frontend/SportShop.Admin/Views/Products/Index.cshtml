@*
    Quản lý sản phẩm: thẻ sản phẩm dạng LƯỚI hoặc DANH SÁCH (đổi bằng 2 nút góc phải),
    tìm theo tên / lọc theo loại, và bảng biến thể (size, màu, giá bán, giá vốn, tồn).
    Phần đổi chế độ xem + lọc nằm ở khối @section Scripts bên dưới.
*@
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    string Tone(string cat) => cat switch { "Giày" => "t-teal", "Quần áo" => "t-orange", "Vợt cầu lông" => "t-purple", _ => "t-blue" };

    // Dữ liệu biến thể → bảng ở cuối trang (dùng lại partial _Section)
    var variants = Data.ActiveVariants.Select(v => new Row(
        [$"BT{v.Id:D3}", Data.Product(v.ProductId).Name, v.Size ?? "-", v.Color ?? "-", Fmt.Money(v.Price), Fmt.Money(v.Cost), v.Stock.ToString()], null, v.Id)).ToList();
    var variantSection = new TableSection
    {
        Heading = "Biến thể sản phẩm (size, màu, giá bán, giá vốn, tồn)",
        Columns = ["Mã BT", "Sản phẩm", "Size", "Màu", "Giá bán", "Giá vốn", "Tồn"],
        Rows = variants, AddLabel = "Thêm biến thể", ShowActions = true, Entity = "variant"
    };
}
<div class="page-head">
    <div>
        <div class="eyebrow">SPORTSHOP ADMIN</div>
        <h1 class="page-title">Quản lý sản phẩm</h1>
        <p class="page-sub">Quản lý danh sách và biến thể sản phẩm</p>
    </div>
</div>

<section class="card" id="prodCard">
    <div class="toolbar">
        <label class="search">
            @Icons.Svg("search", 18)
            <input type="search" id="prodSearch" placeholder="Tìm tên, mã hoặc loại sản phẩm..." autocomplete="off" />
            <kbd>Ctrl K</kbd>
        </label>
        <div class="select-wrap">
            @Icons.Svg("sliders", 18)
            <select id="prodCat">
                <option value="">Loại sản phẩm</option>
                @foreach (var c in Data.Categories) { <option>@c</option> }
            </select>
        </div>
        <span class="grow"></span>
        <div class="seg">
            <button type="button" class="active" id="viewGrid" title="Dạng lưới">@Icons.Svg("layout-grid", 20)</button>
            <button type="button" id="viewList" title="Dạng danh sách">@Icons.Svg("list", 20)</button>
        </div>
        <button type="button" class="btn-primary" data-crud="create" data-entity="product">@Icons.Svg("plus", 18) Thêm sản phẩm</button>
    </div>

    @* ----- Dạng lưới ----- *@
    <div class="prod-grid" id="prodGrid">
        @foreach (var p in Data.ActiveProducts)
        {
            var vs = Data.Variants.Where(v => v.ProductId == p.Id).ToList();
            var price = vs.Count == 0 ? "Chưa có giá" : vs.Min(v => v.Price) == vs.Max(v => v.Price) ? Fmt.Money(vs[0].Price) : $"{Fmt.Money(vs.Min(v => v.Price))} - {Fmt.Money(vs.Max(v => v.Price))}";
            <article class="prod" data-crud="edit" data-entity="product" data-id="@p.Id" title="Bấm để sửa sản phẩm" data-cat="@p.Category" data-text="@(p.Name + " " + p.Category + " SP" + p.Id.ToString("D3"))">
                <div class="prod-img @Tone(p.Category)">
                    <span>@p.Name.Substring(0, 1)</span>
                    @* Ảnh đại diện (ảnh của biến thể đầu tiên, BIEN_THE_SP.hinh_anh); không tải được ảnh thì hiện chữ cái đầu phía sau *@
                    @if (!string.IsNullOrEmpty(p.Image)) { <img src="@p.Image" alt="@p.Name" loading="lazy" onerror="this.remove()" /> }
                    <button type="button" class="dots light" data-crud="edit" data-entity="product" data-id="@p.Id" aria-label="Chỉnh sửa sản phẩm">@Icons.Svg("more", 18)</button>
                </div>
                <div class="prod-body">
                    <div class="prod-top"><small>@p.Category</small>@Fmt.Cell(p.Visible ? "[g]Đang bán" : "[x]Đang ẩn")</div>
                    <h3>@p.Name</h3>
                    <div class="prod-price">@price</div>
                    <div class="prod-meta">@vs.Count biến thể · Tồn @vs.Sum(v => v.Stock) @p.Unit</div>
                </div>
            </article>
        }
    </div>

    @* ----- Dạng danh sách (ẩn mặc định) ----- *@
    <div class="table-wrap" id="prodList" hidden>
        <table class="tbl">
            <thead><tr><th>Mã SP</th><th>Tên sản phẩm</th><th>Loại</th><th>ĐVT</th><th>Giá bán</th><th>Tồn</th><th>Hiển thị</th><th>Thao tác</th></tr></thead>
            <tbody>
                @foreach (var p in Data.ActiveProducts)
                {
                    var vs = Data.Variants.Where(v => v.ProductId == p.Id).ToList();
                    var price = vs.Count == 0 ? "Chưa có giá" : vs.Min(v => v.Price) == vs.Max(v => v.Price) ? Fmt.Money(vs[0].Price) : $"{Fmt.Money(vs.Min(v => v.Price))} - {Fmt.Money(vs.Max(v => v.Price))}";
                    <tr data-cat="@p.Category" data-text="@(p.Name + " " + p.Category + " SP" + p.Id.ToString("D3"))">
                        <td>SP@(p.Id.ToString("D3"))</td><td><div class="prod-name">@if (!string.IsNullOrEmpty(p.Image)) { <img class="prod-thumb" src="@p.Image" alt="" loading="lazy" onerror="this.remove()" /> }@p.Name</div></td><td>@p.Category</td><td>@p.Unit</td><td>@price</td><td>@vs.Sum(v => v.Stock)</td>
                        <td>@Fmt.Cell(p.Visible ? "[g]Đang bán" : "[x]Đang ẩn")</td>
                        <td><div class="actions">
                            <button type="button" class="act" data-crud="view" data-entity="product" data-id="@p.Id">@Icons.Svg("eye", 18)</button>
                            <button type="button" class="act" data-crud="edit" data-entity="product" data-id="@p.Id">@Icons.Svg("pencil", 18)</button>
                            <button type="button" class="act" data-crud="delete" data-entity="product" data-id="@p.Id" data-name="@p.Name">@Icons.Svg("trash", 18)</button>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="empty" id="prodEmpty" hidden>Không tìm thấy sản phẩm phù hợp</div>
</section>

<partial name="_Section" model="variantSection" view-data='new ViewDataDictionary(ViewData) { { "id", "tblVariants" }, { "hint", "biến thể" } }' />

@section Scripts {
    <script>
        // ----- Quản lý sản phẩm: đổi dạng xem + tìm kiếm + lọc theo loại -----
        (function () {
            var grid = document.getElementById('prodGrid'), list = document.getElementById('prodList');
            var btnGrid = document.getElementById('viewGrid'), btnList = document.getElementById('viewList');
            var search = document.getElementById('prodSearch'), cat = document.getElementById('prodCat');
            var empty = document.getElementById('prodEmpty');

            // Đổi giữa dạng lưới và dạng danh sách
            function setView(isGrid) {
                grid.hidden = !isGrid; list.hidden = isGrid;
                btnGrid.classList.toggle('active', isGrid); btnList.classList.toggle('active', !isGrid);
            }
            btnGrid.onclick = function () { setView(true); };
            btnList.onclick = function () { setView(false); };

            // Ẩn/hiện từng sản phẩm theo từ khóa và loại đang chọn
            function apply() {
                var q = search.value.trim().toLowerCase(), c = cat.value, shown = 0;
                document.querySelectorAll('#prodGrid .prod, #prodList tbody tr').forEach(function (el) {
                    var ok = (!c || el.dataset.cat === c) && (!q || el.dataset.text.toLowerCase().indexOf(q) >= 0);
                    el.style.display = ok ? '' : 'none';
                    if (ok && el.classList.contains('prod')) shown++;
                });
                empty.hidden = shown > 0;
            }
            search.addEventListener('input', apply); cat.addEventListener('change', apply);
        })();
    </script>
}
