<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:services="clr-namespace:SportShop.Mobile.Services"
             x:Class="SportShop.Mobile.InfoPagesPage" x:DataType="vm:InfoPagesViewModel"
             Title="Thông tin và hỗ trợ" BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" AutomationId="InfoError" />
            <Button Text="Thử lại" Clicked="OnRetryClicked" IsVisible="{Binding HasError}" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />
            <VerticalStackLayout IsVisible="{Binding ShowList}" Spacing="14">
                <Label Text="Thông tin và hỗ trợ" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                <Label Text="Chính sách, hướng dẫn chọn size và thông tin cửa hàng." Style="{StaticResource SmallMuted}" />
                <Label Text="Hiện chưa có trang thông tin." IsVisible="{Binding ShowEmpty}" Style="{StaticResource SmallMuted}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pages}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:ContentPageSummary">
                            <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="{Binding Eyebrow}" TextColor="{StaticResource Teal}" FontSize="11" />
                                    <Label Text="{Binding Title}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                    <Label Text="{Binding Intro}" Style="{StaticResource SmallMuted}" />
                                    <Button Text="Xem chi tiết" Clicked="OnPageClicked" Style="{StaticResource OutlineButton}" AutomationId="OpenInfoPage" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding ShowPage}" Spacing="14">
                <Button Text="Tất cả trang thông tin" Clicked="OnAllClicked" IsEnabled="{Binding IsIdle}" Style="{StaticResource OutlineButton}" />
                <Label Text="{Binding Current.Eyebrow}" TextColor="{StaticResource Teal}" FontSize="12" />
                <Label Text="{Binding Current.Title}" FontSize="25" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" AutomationId="InfoTitle" />
                <Label Text="{Binding Current.Intro}" TextColor="{StaticResource Ink}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Current.Sections}" Spacing="18">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:ContentSection">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Heading}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Paragraphs}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" TextColor="{StaticResource Ink}" LineHeight="1.3" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
