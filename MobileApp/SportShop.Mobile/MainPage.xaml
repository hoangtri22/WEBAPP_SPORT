<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             x:Class="SportShop.Mobile.MainPage" x:DataType="vm:CatalogViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Bg}" Title="Sản phẩm">
    <ContentPage.Resources>
        <Style x:Key="CatalogAction" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BorderColor" Value="{StaticResource Line}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" Padding="16,12,16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="SPORTSHOP" FontFamily="OpenSansSemibold" FontSize="10"
                           CharacterSpacing="1.8" TextColor="{StaticResource Teal}" />
                    <Label Text="Sản phẩm" FontFamily="OpenSansSemibold" FontSize="26"
                           TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                    <ImageButton Source="ic_shopping_bag_teal.png" Clicked="OnCartNavClicked"
                                 WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                 SemanticProperties.Description="Mở giỏ hàng" AutomationId="CatalogCart" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 14">
                    <SearchBar x:Name="ProductSearchBar" Placeholder="Tìm tên sản phẩm…" Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}" MaxLength="100" HeightRequest="52"
                               BackgroundColor="Transparent" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}"
                               CancelButtonColor="{StaticResource Teal}" FontSize="14" AutomationId="ProductSearch"
                               SemanticProperties.Description="Tìm kiếm sản phẩm theo tên" />
                </Border>
                <Button Grid.Column="1" Text="Tìm" Command="{Binding SearchCommand}" BackgroundColor="{StaticResource Teal}"
                        TextColor="White" CornerRadius="14" Padding="14,8" MinimumWidthRequest="56"
                        AutomationId="ApplyCatalogFilters" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Bộ lọc" ImageSource="ic_filter_teal.png" ContentLayout="Left,8"
                        Clicked="OnAdvancedFiltersClicked" Style="{StaticResource CatalogAction}"
                        TextColor="{StaticResource Teal}" AutomationId="AdvancedCatalogFilters" />
                <Button Grid.Column="1" Text="{Binding AppliedSortName}" ImageSource="ic_sort_ink.png" ContentLayout="Left,8"
                        Clicked="OnSortClicked" Style="{StaticResource CatalogAction}" AutomationId="ProductSort"
                        SemanticProperties.Description="{Binding AppliedSortName, StringFormat='Sắp xếp: {0}'}" />
            </Grid>

            <VerticalStackLayout Grid.Row="3" Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="28">
                    <Label Text="{Binding ResultSummary}" FontFamily="OpenSansSemibold" FontSize="13"
                           TextColor="{StaticResource Ink}" VerticalOptions="Center" AutomationId="ProductCount" />
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Teal}" HeightRequest="24" WidthRequest="24" />
                    <Button Grid.Column="1" Text="Đặt lại" Command="{Binding ResetCommand}"
                            BackgroundColor="Transparent" TextColor="{StaticResource Teal}"
                            FontSize="12" Padding="8,0" IsEnabled="{Binding IsIdle}" AutomationId="ResetCatalogFilters">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <Label Text="{Binding AppliedFilterSummary}" IsVisible="{Binding HasRefinements}" FontSize="12"
                       TextColor="{StaticResource Muted}" MaxLines="2" LineBreakMode="TailTruncation"
                       AutomationId="AppliedCatalogFilters" />
            </VerticalStackLayout>

            <Grid x:Name="CatalogResults" Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8">
                <VerticalStackLayout Spacing="8">
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF3EB" Stroke="#F4D4BE"
                        StrokeShape="RoundRectangle 14" Padding="14" AutomationId="CatalogError">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Chưa tải được sản phẩm" TextColor="#873F20"
                               FontFamily="OpenSansSemibold" FontSize="14" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#873F20" FontSize="13" />
                        <Button Text="Thử lại" Command="{Binding RetryCommand}" IsEnabled="{Binding IsIdle}"
                                HorizontalOptions="Start" BackgroundColor="{StaticResource Teal}" TextColor="White"
                                CornerRadius="10" AutomationId="RetryCatalog" />
                    </VerticalStackLayout>
                </Border>
                    <Label Text="{Binding ValidationError}" IsVisible="{Binding HasValidationError}"
                           TextColor="#873F20" FontSize="12" />
                    <Label Text="Một số bộ lọc chưa tải được. Mở Bộ lọc để thử lại." IsVisible="{Binding HasFilterError}"
                           TextColor="#873F20" FontSize="12">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
                <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"
                             RefreshColor="{StaticResource Teal}" AutomationId="RefreshCatalog">
                    <CollectionView ItemsSource="{Binding Products}" SelectionMode="None" AutomationId="ProductList">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="24,32" Spacing="12" IsVisible="{Binding ShowEmpty}"
                                                 WidthRequest="{Binding Width, Source={x:Reference CatalogResults}, x:DataType=Grid}">
                                <Border BackgroundColor="{StaticResource TealSoft}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24" HorizontalOptions="Center" Padding="18">
                                    <Image Source="ic_search_ink.png" HeightRequest="28" WidthRequest="28" />
                                </Border>
                                <Label Text="Chưa tìm thấy sản phẩm" FontFamily="OpenSansSemibold" FontSize="18"
                                       TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                                <Label Text="Thử từ khóa khác hoặc điều chỉnh bộ lọc để có thêm lựa chọn."
                                       FontSize="13" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                                <Button Text="Xem tất cả sản phẩm" Command="{Binding ResetCommand}"
                                        HorizontalOptions="Center" BackgroundColor="{StaticResource Teal}" TextColor="White"
                                        CornerRadius="12" AutomationId="ResetEmptyCatalog" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductCard">
                                <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 16"
                                        SemanticProperties.Description="{Binding AccessibilityDescription}"
                                        SemanticProperties.Hint="Chạm để xem chi tiết và chọn size, màu">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProductTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid HeightRequest="156" BackgroundColor="#EEF4F3">
                                            <Image Source="ic_shopping_bag_muted.png" WidthRequest="32" HeightRequest="32"
                                                   Opacity="0.25" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="12"
                                                   SemanticProperties.Description="{Binding Name}" />
                                        </Grid>
                                        <VerticalStackLayout Padding="12" Spacing="6">
                                            <Label Text="{Binding CategoryName}" TextColor="{StaticResource Muted}" FontSize="11"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Name}" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold"
                                                   FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" MinimumHeightRequest="42" />
                                            <Label Text="{Binding PriceText}" TextColor="{StaticResource Teal}"
                                                   FontFamily="OpenSansSemibold" FontSize="16" MaxLines="1" />
                                            <Label Text="{Binding StockText}" TextColor="{StaticResource Teal}" FontSize="11">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding InStock}" Value="False">
                                                        <Setter Property="TextColor" Value="{StaticResource Muted}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="0,18,0,24" Spacing="12" IsVisible="{Binding HasProducts}"
                                                 WidthRequest="{Binding Width, Source={x:Reference CatalogResults}, x:DataType=Grid}">
                                <Button Text="Xem thêm sản phẩm" Command="{Binding LoadMoreCommand}"
                                        IsVisible="{Binding HasMore}" IsEnabled="{Binding IsIdle}"
                                        Style="{StaticResource CatalogAction}" TextColor="{StaticResource Teal}" AutomationId="LoadMore" />
                                <Label Text="Kéo xuống để làm mới danh sách" TextColor="{StaticResource Muted}"
                                       FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
                <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsInitialLoading}" VerticalOptions="Center"
                                     HorizontalOptions="Center" Spacing="12" InputTransparent="True">
                    <ActivityIndicator IsRunning="{Binding IsInitialLoading}" Color="{StaticResource Teal}" />
                    <Label Text="Đang tìm sản phẩm cho bạn…" FontSize="13" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="8,4" BackgroundColor="White">
            <Button Text="Trang chủ" Clicked="OnHomeNavClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
            <Button Grid.Column="1" Text="Sản phẩm" BackgroundColor="Transparent" TextColor="{StaticResource Teal}" FontSize="11" Padding="0" />
            <Button Grid.Column="2" Text="Giỏ hàng" Clicked="OnCartNavClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
            <Button Grid.Column="3" Text="Tài khoản" Clicked="OnAccountNavClicked" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" FontSize="11" Padding="0" />
        </Grid>
    </Grid>
</ContentPage>
