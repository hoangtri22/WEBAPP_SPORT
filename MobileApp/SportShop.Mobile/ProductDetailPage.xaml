<?xml version="1.0" encoding="utf-8" ?>
<!-- Chi tiết sản phẩm, tương ứng Views/Shop/Detail.cshtml của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.ProductDetailPage" x:DataType="vm:ProductDetailViewModel"
             Title="Chi tiết sản phẩm">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Giỏ hàng" IconImageSource="ic_shopping_bag_ink.png" Clicked="OnCartClicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,24">
                <VerticalStackLayout IsVisible="{Binding IsBusy}" Padding="0,40" Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                    <Label Text="Đang tải sản phẩm…" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <controls:EmptyState IsVisible="{Binding HasError}" IsError="True" Icon="ic_wifi_off_muted.png" Title="Chưa tải được sản phẩm"
                                     Message="{Binding ErrorMessage}" ActionText="Tải lại" ActionClicked="OnRetryClicked" AutomationId="ProductDetailError" />

                <VerticalStackLayout IsVisible="{Binding HasProduct}" Spacing="14">
                    <Grid HeightRequest="320" BackgroundColor="White">
                        <Image Source="ic_activity_teal.png" WidthRequest="40" HeightRequest="40" Opacity="0.15" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="20" SemanticProperties.Description="{Binding Name}" />
                    </Grid>

                    <VerticalStackLayout Padding="16,0" Spacing="6">
                        <Label Text="{Binding CategoryName}" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="22" />
                        <Label Text="{Binding PriceText}" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource Teal}" AutomationId="VariantPrice" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource SectionCard}" Margin="16,0">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Chọn phiên bản (size / màu)" Style="{StaticResource CardTitle}" FontSize="14" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Hướng dẫn chọn size" Clicked="OnSizeGuideClicked" Style="{StaticResource GhostButton}" FontSize="12" />
                            </Grid>
                            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Variants}" AutomationId="ProductVariant">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProductVariantOption">
                                        <Border Style="{StaticResource Chip}" StrokeShape="RoundRectangle 12" Padding="12,6" Margin="0,0,8,8" MinimumWidthRequest="72">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnVariantTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Teal}" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource TealTint}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="{Binding ChipTitle}" FontFamily="OpenSansSemibold" FontSize="13" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding ChipSubtitle}" Style="{StaticResource SmallMuted}" FontSize="11" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Số lượng" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding StockText}" Style="{StaticResource SmallMuted}" AutomationId="VariantStock" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" Padding="0" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="44,56,44">
                                        <ImageButton Source="ic_minus_ink.png" Clicked="OnDecreaseClicked" IsEnabled="{Binding CanDecrease}" WidthRequest="44" HeightRequest="44" Padding="13"
                                                     SemanticProperties.Description="Giảm số lượng" />
                                        <Entry Grid.Column="1" Text="{Binding QuantityText}" Keyboard="Numeric" MaxLength="3" HorizontalTextAlignment="Center"
                                               IsEnabled="{Binding CanBuy}" FontFamily="OpenSansSemibold" AutomationId="ProductQuantity" />
                                        <ImageButton Grid.Column="2" Source="ic_plus_ink.png" Clicked="OnIncreaseClicked" IsEnabled="{Binding CanIncrease}" WidthRequest="44" HeightRequest="44" Padding="13"
                                                     SemanticProperties.Description="Tăng số lượng" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding HasStatus}" Style="{StaticResource AlertSuccess}" Margin="16,0">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource AlertSuccessText}" AutomationId="ProductAdded" />
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="16,0" Padding="14,4">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" MinimumHeightRequest="44">
                                <Image Source="ic_truck_teal.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Miễn phí giao hàng cho đơn từ 500.000₫" FontSize="13" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" MinimumHeightRequest="44">
                                <Image Source="ic_shield_check_teal.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Chính hãng, đổi trả trong 30 ngày" FontSize="13" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48" AutomationId="ProductReviews">
                                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReviewsTapped" /></Grid.GestureRecognizers>
                                <Image Source="ic_star_orange.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Xem và gửi đánh giá sản phẩm" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Image Grid.Column="2" Source="ic_chevron_right_muted.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Padding="16,0" Spacing="6">
                        <Label Text="Thông tin sản phẩm" Style="{StaticResource SectionTitle}" FontSize="16" />
                        <Label Text="{Binding Description}" Style="{StaticResource BodyText}" />
                        <Label Text="Giá và tồn kho được xác nhận lại khi thêm giỏ và thanh toán." Style="{StaticResource SmallMuted}" FontSize="11" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10" AutomationId="RelatedProductsSection">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="CÓ THỂ BẠN THÍCH" Style="{StaticResource Eyebrow}" />
                                <Label Text="Sản phẩm cùng loại" Style="{StaticResource SectionTitle}" FontSize="16" />
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsRelatedLoading}" IsVisible="{Binding IsRelatedLoading}" HeightRequest="24" WidthRequest="24" />
                        </Grid>
                        <Border IsVisible="{Binding HasRelatedError}" Style="{StaticResource AlertError}" Margin="16,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding RelatedErrorMessage}" Style="{StaticResource AlertErrorText}" FontSize="12" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Thử lại" Clicked="OnRetryRelatedClicked" IsEnabled="{Binding CanRetryRelated}" Style="{StaticResource GhostButton}" AutomationId="RetryRelatedProducts" />
                            </Grid>
                        </Border>
                        <Label Text="Chưa có sản phẩm cùng loại còn hàng." IsVisible="{Binding ShowRelatedEmpty}" Style="{StaticResource Caption}" Margin="16,0" AutomationId="RelatedProductsEmpty" />
                        <CollectionView ItemsSource="{Binding RelatedProducts}" SelectionMode="None" HeightRequest="250"
                                        IsVisible="{Binding HasRelatedProducts}" AutomationId="RelatedProductList">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <BoxView WidthRequest="6" Color="Transparent" />
                            </CollectionView.Header>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductCard">
                                    <Border WidthRequest="156" Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRelatedProductTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid HeightRequest="130" BackgroundColor="{StaticResource TealTint}">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="8" SemanticProperties.Description="{Binding Name}" />
                                            </Grid>
                                            <VerticalStackLayout Padding="10" Spacing="4">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="38" />
                                                <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" FontSize="14" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" IsVisible="{Binding HasProduct}" Style="{StaticResource BottomBar}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Thêm vào giỏ" ImageSource="ic_shopping_bag_teal.png" ContentLayout="Left,6" Clicked="OnAddClicked" IsEnabled="{Binding CanBuy}"
                        Style="{StaticResource OutlineButton}" AutomationId="AddProductToCart" />
                <Button Grid.Column="1" Text="Mua ngay" Clicked="OnBuyNowClicked" IsEnabled="{Binding CanBuy}" Style="{StaticResource PrimaryButton}" AutomationId="BuyProductNow" />
            </Grid>
        </Border>

        <Grid x:Name="AddSuccessOverlay" Grid.RowSpan="2" ZIndex="10" IsVisible="False" BackgroundColor="#80000000" AutomationId="ProductAddedDialog">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOverlayTapped" /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,24" VerticalOptions="End">
                <VerticalStackLayout Spacing="14">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="{StaticResource Gray300}" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource TealTint}">
                            <Image Source="{Binding ImageUrl}" HeightRequest="64" WidthRequest="64" Aspect="AspectFit" Margin="6" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="ic_check_circle_teal.png" WidthRequest="16" HeightRequest="16" />
                                <Label Text="ĐÃ THÊM VÀO GIỎ" Style="{StaticResource Eyebrow}" FontSize="10" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" FontSize="13" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="2" Source="ic_x_muted.png" Clicked="OnDismissAddedClicked" WidthRequest="40" HeightRequest="40" Padding="10"
                                     VerticalOptions="Start" SemanticProperties.Description="Đóng thông báo" AutomationId="DismissProductAdded" />
                    </Grid>
                    <Label Text="Đã thêm sản phẩm vào giỏ hàng thành công!" FontFamily="OpenSansSemibold" FontSize="16" AutomationId="ProductAddedSuccessMessage" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Tiếp tục mua sắm" Clicked="OnContinueShoppingClicked" Style="{StaticResource SecondaryButton}" HeightRequest="50" AutomationId="ContinueShoppingAfterAdd" />
                        <Button Grid.Column="1" Text="Xem giỏ hàng" Clicked="OnCartClicked" Style="{StaticResource PrimaryButton}" HeightRequest="50" AutomationId="ViewCartAfterAdd" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
