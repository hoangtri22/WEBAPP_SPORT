<?xml version="1.0" encoding="utf-8" ?>
<!-- Giỏ hàng, tương ứng Views/Cart/Index.cshtml của web khách. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportShop.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SportShop.Mobile.Controls"
             x:Class="SportShop.Mobile.CartPage" x:DataType="vm:CartViewModel"
             NavigationPage.HasNavigationBar="False" Title="Giỏ hàng">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Padding="16,12,10,12" BackgroundColor="White">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="Giỏ hàng" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding OrderSummaryHeaderText}" IsVisible="{Binding HasItems}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Đơn hàng" ImageSource="ic_package_teal.png" ContentLayout="Left,6" Clicked="OnOpenOrdersClicked"
                    Style="{StaticResource SoftButton}" HeightRequest="40" Padding="12,0" FontSize="13" VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1" Refreshing="OnRefreshing" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView>
                <VerticalStackLayout Padding="16,14,16,24" Spacing="14">
                    <Border IsVisible="{Binding HasError}" Style="{StaticResource AlertError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource AlertErrorText}" />
                    </Border>
                    <Border IsVisible="{Binding HasStatus}" Style="{StaticResource AlertSuccess}">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource AlertSuccessText}" />
                    </Border>

                    <Border x:Name="GuestLoginCard" IsVisible="False" Style="{StaticResource AlertInfo}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Source="ic_info_teal.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Mua hàng không cần tài khoản" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TealDark}" />
                                <Label Text="Đơn lưu theo số điện thoại. Đăng nhập để dùng mã giảm giá thành viên." FontSize="12" TextColor="{StaticResource InkSoft}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Đăng nhập" Clicked="OnLoginClicked" HeightRequest="36" Padding="12,0" FontSize="12" CornerRadius="10" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <controls:EmptyState x:Name="EmptyCartCard" IsVisible="{Binding IsEmpty}" Icon="ic_shopping_bag_teal.png"
                                         Title="Giỏ hàng đang trống" Message="Hãy chọn vài món đồ bạn thích nhé."
                                         ActionText="Tiếp tục mua sắm" ActionClicked="OnContinueShoppingClicked" />

                    <VerticalStackLayout x:Name="CartContentSection" IsVisible="{Binding HasItems}" Spacing="14">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CartLineItem">
                                    <Border Style="{StaticResource Card}" Padding="12">
                                        <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                                            <Border BackgroundColor="{StaticResource TealTint}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    WidthRequest="80" HeightRequest="80" VerticalOptions="Start">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCartItemTapped" CommandParameter="{Binding ProductId}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="6" />
                                            </Border>
                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding VariantLabel}" IsVisible="{Binding HasVariantLabel}" Style="{StaticResource Caption}" />
                                                    </VerticalStackLayout>
                                                    <ImageButton Grid.Column="1" Source="ic_trash_muted.png" CommandParameter="{Binding .}" Clicked="OnRemoveItemClicked"
                                                                 WidthRequest="36" HeightRequest="36" Padding="8" VerticalOptions="Start"
                                                                 SemanticProperties.Description="{Binding Name, StringFormat='Xóa {0} khỏi giỏ'}" />
                                                </Grid>
                                                <Label Grid.Row="1" Text="{Binding StockWarningText}" IsVisible="{Binding HasWarning}" FontSize="11" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" />
                                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalOptions="End">
                                                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                        <Label Text="{Binding AmountText}" Style="{StaticResource PriceText}" FontSize="15" />
                                                        <Label Text="{Binding UnitPriceText, StringFormat='{0} / sản phẩm'}" Style="{StaticResource SmallMuted}" FontSize="11" />
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="1" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" Padding="0" VerticalOptions="Center">
                                                        <Grid ColumnDefinitions="40,36,40">
                                                            <ImageButton Source="ic_minus_ink.png" CommandParameter="{Binding .}" Clicked="OnDecreaseQtyClicked"
                                                                         WidthRequest="40" HeightRequest="38" Padding="11" SemanticProperties.Description="Giảm số lượng" />
                                                            <Label Grid.Column="1" Text="{Binding Quantity}" FontFamily="OpenSansSemibold" FontSize="14"
                                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                            <ImageButton Grid.Column="2" Source="ic_plus_ink.png" CommandParameter="{Binding .}" Clicked="OnIncreaseQtyClicked"
                                                                         WidthRequest="40" HeightRequest="38" Padding="11" SemanticProperties.Description="Tăng số lượng" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Gợi ý mua thêm, tương ứng khối cart-upsell của Views/Cart/Index.cshtml. -->
                        <Border IsVisible="{Binding HasUpsell}" Style="{StaticResource SectionCard}" Stroke="#99D5CD">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{StaticResource OrangeSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" Padding="8">
                                        <Image Source="ic_sparkles_orange.png" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding UpsellHeaderText}" FontFamily="OpenSansSemibold" FontSize="13" />
                                        <Label Text="{Binding UpsellSubText}" FontSize="12" TextColor="{StaticResource Teal}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                                    <HorizontalStackLayout Spacing="10" Padding="16,0" BindableLayout.ItemsSource="{Binding UpsellItems}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CartUpsellItemViewModel">
                                                <Border Style="{StaticResource Card}" WidthRequest="150" Padding="10">
                                                    <VerticalStackLayout Spacing="6">
                                                        <Border BackgroundColor="{StaticResource TealTint}" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="90">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnUpsellItemProductTapped" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="6" />
                                                        </Border>
                                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="12" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                                                        <Label Text="{Binding PriceText}" Style="{StaticResource PriceText}" FontSize="13" />
                                                        <Button Text="{Binding ActionButtonText}" CommandParameter="{Binding .}" Clicked="OnUpsellItemActionClicked"
                                                                Style="{StaticResource SoftButton}" HeightRequest="36" FontSize="12" CornerRadius="10" Padding="6,0" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tóm tắt đơn hàng, tương ứng khối cart-summary của Views/Cart/Index.cshtml. -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Tóm tắt đơn hàng" Style="{StaticResource CardTitle}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tạm tính" Style="{StaticResource Caption}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SubtotalText}" FontFamily="OpenSansSemibold" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCartOrderPromo}">
                                    <Label Text="{Binding CartOrderPromoLabel}" Style="{StaticResource Caption}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding CartOrderPromoDiscountText}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Success}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Phí giao hàng" Style="{StaticResource Caption}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding EstimatedShippingText}" FontFamily="OpenSansSemibold" FontSize="13" />
                                </Grid>
                                <Label Text="Miễn phí giao hàng cho đơn từ 500.000₫. Mã giảm giá được chọn ở bước thanh toán và thay cho mức giảm theo đơn."
                                       Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="2" IsVisible="{Binding HasItems}" Style="{StaticResource BottomBar}">
            <VerticalStackLayout Spacing="8">
                <Label IsVisible="{Binding HasStockWarning}" Text="Vui lòng giảm số lượng các sản phẩm vượt tồn kho."
                       FontSize="12" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="Tổng cộng" Style="{StaticResource Caption}" />
                        <Label Text="{Binding EstimatedTotalText}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource Teal}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Thanh toán" Clicked="OnProceedCheckoutClicked" IsEnabled="{Binding CanProceedToCheckout}"
                            Style="{StaticResource PrimaryButton}" Padding="28,0" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
